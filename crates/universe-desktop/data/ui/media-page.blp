using Gtk 4.0;
using Adw 1;

template $UniverseMediaPage: Adw.Bin {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button sidebar_button {
        action-name: "win.show-sidebar";
        icon-name: "sidebar-show-symbolic";
        tooltip-text: _("Show Sidebar");
      }

      title-widget: Adw.ToggleGroup kinds {
        can-shrink: true;
        active-name: "all";

        Adw.Toggle {
          name: "all";
          label: _("All");
        }

        Adw.Toggle {
          name: "shots";
          label: _("Screenshots");
        }

        Adw.Toggle {
          name: "recordings";
          label: _("Recordings");
        }

        Adw.Toggle {
          name: "journal";
          label: _("Journal");
        }
      };

      [end]
      MenuButton {
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        primary: true;
        menu-model: media_menu;
      }
    }

    content: $UniverseMediaGrid grid {};
  };
}

menu media_menu {
  section {
    item {
      label: _("Open _Big Screen");
      action: "app.big-screen";
      hidden-when: "action-missing";
    }
  }

  section {
    item (_("_Preferences"), "app.preferences")
    item (_("_Keyboard Shortcuts"), "app.shortcuts")
    item (_("_About Universe Desktop"), "app.about")
  }
}
