using Gtk 4.0;
using Adw 1;

template $UniverseLibraryPage: Adw.Bin {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button sidebar_button {
        action-name: "win.show-sidebar";
        icon-name: "sidebar-show-symbolic";
        tooltip-text: _("Show Sidebar");
      }

      [start]
      Button {
        icon-name: "list-add-symbolic";
        tooltip-text: _("Add Games");
        action-name: "win.add-game";
      }

      title-widget: Adw.Clamp {
        maximum-size: 420;
        tightening-threshold: 420;

        child: SearchEntry search {
          hexpand: true;
          placeholder-text: _("Search Games");
        };
      };

      [end]
      MenuButton menu_button {
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        primary: true;
      }

      [end]
      MenuButton {
        icon-name: "view-sort-descending-symbolic";
        tooltip-text: _("View Options");
        menu-model: sort_menu;
      }
    }

    content: Adw.ViewStack stack {
      enable-transitions: true;

      Adw.ViewStackPage {
        name: "loading";

        child: Adw.Spinner {
          width-request: 32;
          height-request: 32;
          halign: center;
          valign: center;
        };
      }

      Adw.ViewStackPage {
        name: "grid";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          child: GridView grid {
            name: "grid";
            max-columns: 12;
            single-click-activate: true;
          };
        };
      }

      Adw.ViewStackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "io.github.ilyasturki.UniverseDesktop-symbolic";
          title: _("No Games");
          description: _("Add a game file, or bring in your Lutris, emulator and store games");

          child: Box {
            orientation: vertical;
            spacing: 12;
            halign: center;

            Button {
              label: _("_Add Games…");
              use-underline: true;
              action-name: "win.add-game";

              styles [
                "pill",
                "suggested-action",
              ]
            }

            Button {
              label: _("_Get Started");
              use-underline: true;
              action-name: "win.onboarding";

              styles [
                "pill",
              ]
            }
          };
        };
      }

      Adw.ViewStackPage {
        name: "no-results";

        child: Adw.StatusPage {
          icon-name: "edit-find-symbolic";
          title: _("No Games Found");
          description: _("Try a different search");
        };
      }

      Adw.ViewStackPage {
        name: "no-hidden";

        child: Adw.StatusPage {
          icon-name: "view-conceal-symbolic";
          title: _("No Hidden Games");
          description: _("Games you hide will appear here");
        };
      }

      Adw.ViewStackPage {
        name: "no-favorites";

        child: Adw.StatusPage {
          icon-name: "starred-symbolic";
          title: _("No Favourites");
          description: _("Games you add to your favourites will appear here");
        };
      }
    };
  };
}

menu sort_menu {
  section {
    label: _("Sort");

    item {
      label: _("Last Played");
      action: "win.sort";
      target: "last-played";
    }

    item {
      label: _("A–Z");
      action: "win.sort";
      target: "a-z";
    }

    item {
      label: _("Z–A");
      action: "win.sort";
      target: "z-a";
    }

    item {
      label: _("Newest");
      action: "win.sort";
      target: "newest";
    }

    item {
      label: _("Oldest");
      action: "win.sort";
      target: "oldest";
    }

    item {
      label: _("Most Played");
      action: "win.sort";
      target: "most-played";
    }
  }

  section {
    item (_("Show _Hidden Games"), "win.show-hidden")
  }
}
