diff --git a/src/rendervulkan.cpp b/src/rendervulkan.cpp
index 65411dc..e28b733 100644
--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -2255,10 +2255,21 @@ bool CVulkanTexture::BInit( uint32_t width, uint32_t height, uint32_t depth, uin
 	VkMemoryRequirements memRequirements;
 	g_device.vk.GetImageMemoryRequirements(g_device.device(), m_vkImage, &memRequirements);
 
+	int32_t memTypeIndex = g_device.findMemoryType(properties, memRequirements.memoryTypeBits);
+	// Cached is a read-speed nicety, coherent a correctness requirement (nothing flushes or invalidates mapped ranges):
+	// a driver whose host-visible types are either cached or coherent, never both (ANV on Meteor Lake), still gets a coherent one.
+	if ( memTypeIndex < 0 && ( properties & VK_MEMORY_PROPERTY_HOST_CACHED_BIT ) )
+		memTypeIndex = g_device.findMemoryType(properties & ~VK_MEMORY_PROPERTY_HOST_CACHED_BIT, memRequirements.memoryTypeBits);
+	if ( memTypeIndex < 0 )
+	{
+		vk_log.errorf( "no memory type with properties 0x%x among type bits 0x%x", properties, memRequirements.memoryTypeBits );
+		return false;
+	}
+
 	VkMemoryAllocateInfo allocInfo = {
 		.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
 		.allocationSize = memRequirements.size,
-		.memoryTypeIndex = uint32_t(g_device.findMemoryType(properties, memRequirements.memoryTypeBits)),
+		.memoryTypeIndex = uint32_t(memTypeIndex),
 	};
 
 	m_size = allocInfo.allocationSize;
