#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
usage: tools/readme-video [DIR]

DIR/home.avif (the home row to the launch, then the game) and DIR/home-over-game.avif
(HOME over the game), DIR docs/images by default, from the home and home-over-game
takes of site/media/takes.toml, as `UNIVERSE_DEV=.dev-showcase just docs-media record
home home-over-game` cut them into target/docs-media/masters. Animated AVIF at 1080p60,
which a README's <img> loops without sound.

  UNIVERSE_AVIF_CRF the encode's quality, lower is larger (default 28)
USAGE
}

case "${1:-}" in -h | --help) usage; exit 0 ;; esac
[ $# -le 1 ] || { usage >&2; exit 2; }
masters="$(dirname "$0")/../target/docs-media/masters"
dir=${1:-docs/images}
mkdir -p "$dir"
for name in home home-over-game; do
    [ -f "$masters/$name.mp4" ] ||
        { echo "readme-video: no $masters/$name.mp4: UNIVERSE_DEV=.dev-showcase just docs-media record $name" >&2; exit 1; }
    ffmpeg -hide_banner -loglevel error -y -i "$masters/$name.mp4" -vf fps=60,format=yuv420p \
        -c:v libsvtav1 -crf "${UNIVERSE_AVIF_CRF:-28}" -preset 4 \
        -svtav1-params tune=0:color-primaries=1:transfer-characteristics=1:matrix-coefficients=1:color-range=0 \
        -colorspace bt709 -color_primaries bt709 -color_trc bt709 -color_range tv -loop 0 -an "$dir/$name.avif"
    echo "$dir/$name.avif: $(du -h "$dir/$name.avif" | cut -f1)"
done
