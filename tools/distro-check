#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
usage: tools/distro-check

What a user of a distro other than NixOS goes through, on this one: the core's
tests, tools/dist, install.sh into a fresh HOME, the CLI finding the shipped
modules and sources, doctor, the UI offscreen on the fake library and on the
real core (shots in DISTRO_OUT, default target/distro-check), then
install.sh --uninstall leaving nothing behind.

As a user other than root, where tools/ci-deps set things up (tools/container,
CI). Needs the network: pip fetches PySide6, maturin and setuptools.
USAGE
}

case "${1:-}" in
    -h | --help) usage; exit 0 ;;
esac
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="${DISTRO_OUT:-${CARGO_TARGET_DIR:-$repo/target}/distro-check}"
mkdir -p "$out"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

echo "── test"
# the journal tests expect Paris local time, as the flake's check does
TZ=Europe/Paris cargo test --quiet --locked -p universe --manifest-path "$repo/Cargo.toml"

echo "── dist"
python3 -m venv "$work/build"
"$work/build/bin/pip" install --quiet --upgrade pip
PYTHON="$work/build/bin/python" "$repo/tools/dist" "$work/dist" > /dev/null

echo "── install"
export HOME="$work/home" XDG_CONFIG_HOME="$work/home/.config" XDG_DATA_HOME="$work/home/.local/share" \
    XDG_STATE_HOME="$work/home/.local/state" XDG_CACHE_HOME="$work/home/.cache"
mkdir -p "$HOME"
"$work/dist/install.sh"
export PATH="$HOME/.local/bin:$PATH"

echo "── cli"
universe --version
universe module ls --json > "$work/modules.json"
universe source ls --json > "$work/sources.json"
universe doctor --json > "$work/doctor.json" || true
python3 - "$work" "$HOME/.local/lib/universe" <<'PY'
import json, sys
work, lib = sys.argv[1:]
for kind, want in (("modules", {"capture", "journal", "screenshot"}), ("sources", {"gog"})):
    found = {m["id"]: m["dir"] for m in json.load(open(f"{work}/{kind}.json"))}
    assert want <= set(found), f"{kind}: {sorted(found)}"
    assert all(d.startswith(lib) for d in found.values()), f"{kind} outside the install: {found}"
checks = json.load(open(f"{work}/doctor.json"))
assert checks and all({"check", "ok", "fix"} <= set(c) for c in checks), checks
for c in checks:
    print("ok  " if c["ok"] else "--  ", c["label"], "" if c["ok"] else f"({c['detail']})")
PY

echo "── ui"
ui() {
    local name=$1; shift
    QT_QPA_PLATFORM=offscreen PIPEWIRE_REMOTE=/nonexistent timeout 120 universe-ui --no-gamepad --size 1280x720 --key-gap 300 \
        --keys "Wait:4 Shot:$out/$name.png" --quit-after 15000 "$@"
    [ -s "$out/$name.png" ] || { echo "distro-check: the UI saved no $name.png" >&2; exit 1; }
    echo "$out/$name.png"
}
rm -f "$out"/ui-*.png
ui ui-fake --fake
ui ui-core

echo "── uninstall"
"$work/dist/install.sh" --uninstall
left="$(find "$HOME/.local/bin" "$HOME/.local/lib" "$HOME/.local/share/applications" -mindepth 1 2> /dev/null || true)"
[ -z "$left" ] || { echo "distro-check: left behind:"$'\n'"$left" >&2; exit 1; }
echo "distro-check: ok"
