ARCH_SUFFIX = re.compile(r"[-_.](x86_64_v3|x86_64|amd64|x64|aarch64|arm64)$")


@dataclass(frozen=True)
class Pick:
    pattern: str
    arch: str = "x86_64"
    variant: str = ""
    member: str = ""
    program: str = ""
    # A zip unpacked whole, not one holding an AppImage.
    whole: bool = False


@dataclass(frozen=True)
class Upstream:
    id: str
    name: str
    kind: str
    # github:owner/repo, forgejo:host/owner/repo or broth:package/channel (itch.io's, whose LATEST names the version)
    repo: str
    picks: tuple[Pick, ...]
    family: str = ""
    bin: str = ""
    rolling: bool = False
    # The release's tag must match it.
    tags: str = ""
    # tag, asset (name less extension and arch), date (upload day), or re:<pattern> whose group 1 is read off the asset name
    version: str = "tag"
    latest_only: bool = False
    homepage: str = ""
    # Shown before an install, which waits for it to be accepted.
    notice: str = ""


