def request(url: str) -> urllib.request.Request:
    headers = {"User-Agent": "universe-catalogue", "Accept": "application/vnd.github+json"}
    token = os.environ.get("GITHUB_TOKEN", "")
    if token and url.startswith("https://api.github.com/"):
        headers["Authorization"] = f"Bearer {token}"
    return urllib.request.Request(url, headers=headers)


def get_json(url: str):
    with urllib.request.urlopen(request(url), timeout=60) as r:
        return json.load(r)


def fetch(url: str) -> tuple[str, int, bytes]:
    """sha256, size and, for a .zip only, the bytes."""
    digest, size, kept = hashlib.sha256(), 0, io.BytesIO()
    with urllib.request.urlopen(request(url), timeout=120) as r:
        while chunk := r.read(1 << 20):
            digest.update(chunk)
            size += len(chunk)
            if url.endswith(".zip"):
                kept.write(chunk)
    return digest.hexdigest(), size, kept.getvalue()


def releases(up: Upstream) -> list[dict]:
    source, _, where = up.repo.partition(":")
    if source == "broth":
        with urllib.request.urlopen(request(f"https://broth.itch.zone/{where}/LATEST"), timeout=60) as r:
            version = r.read().decode().strip()
        url = f"https://broth.itch.zone/{where}/{version}/archive/default"
        return [{"tag_name": version, "assets": [{"name": f"{up.bin}.zip", "browser_download_url": url}]}]
    if source == "github":
        base = f"https://api.github.com/repos/{where}/releases"
        found = [get_json(f"{base}/latest")] if up.latest_only else get_json(f"{base}?per_page=30")
    else:
        host, _, repo = where.partition("/")
        found = get_json(f"https://{host}/api/v1/repos/{repo}/releases?limit=20")
    found = [r for r in found if not r.get("draft") and (up.rolling or not r.get("prerelease")) and re.search(up.tags, r.get("tag_name", ""))]
    found.sort(key=lambda r: r.get("published_at") or "", reverse=True)
    return found[:RELEASES_READ]


def fmt(name: str) -> str:
    lower = name.lower()
    for ext, kind in ((".appimage", "appimage"), (".tar.gz", "tar.gz"), (".tgz", "tar.gz"), (".tar.xz", "tar.xz"), (".tar", "tar"), (".zip", "zip")):
        if lower.endswith(ext):
            return kind
    return "binary"


def stem(name: str) -> str:
    for ext in (".AppImage", ".appimage", ".tar.gz", ".tgz", ".tar.xz", ".tar", ".zip"):
        name = name.removesuffix(ext)
    return ARCH_SUFFIX.sub("", name)


def version_of(up: Upstream, release: dict, asset: dict) -> str:
    if up.version == "asset":
        return stem(asset["name"])
    if up.version == "date":
        return (asset.get("updated_at") or release.get("published_at") or "")[:10].replace("-", ".")
    if up.version.startswith("re:"):
        found = re.search(up.version.removeprefix("re:"), asset["name"])
        return found.group(1) if found else release["tag_name"]
    return re.sub(r"^v\.?(?=\d)", "", release["tag_name"])


def build_of(up: Upstream, release: dict, known: dict[str, dict]) -> dict | None:
    assets, version = [], ""
    for pick in up.picks:
        asset = next((a for a in release.get("assets", []) if re.search(pick.pattern, a["name"])), None)
        if asset is None:
            continue
        url = asset["browser_download_url"]
        version = version or version_of(up, release, asset)
        entry: dict = {"arch": pick.arch, "url": url, "format": fmt(asset["name"])}
        zipped = entry["format"] == "zip" and not pick.whole
        for key in ("variant", "member", "program"):
            if getattr(pick, key):
                entry[key] = getattr(pick, key)
        previous = known.get(url)
        digest = (asset.get("digest") or "").removeprefix("sha256:")
        if previous and (not digest or previous["sha256"] == digest):
            entry.update({k: previous[k] for k in ("sha256", "size", "appimage") if k in previous})
        elif digest and not zipped:
            entry.update(sha256=digest, size=asset.get("size") or 0)
        else:
            print(f"  hashing {asset['name']}", file=sys.stderr)
            sha, size, body = fetch(url)
            entry.update(sha256=sha, size=size)
            if zipped:
                inner = next((n for n in zipfile.ZipFile(io.BytesIO(body)).namelist() if n.endswith(".AppImage")), None)
                if inner is None:
                    print(f"  {asset['name']}: no AppImage inside", file=sys.stderr)
                entry["appimage"] = inner
        if zipped and not entry.get("appimage"):
            continue
        assets.append(entry)
    if not assets:
        return None
    channel = "rolling" if up.rolling or release.get("prerelease") else "stable"
    return {"version": version, "date": release.get("published_at") or "", "channel": channel, "assets": assets}


def component(up: Upstream, previous: dict | None) -> dict:
    old = (previous or {}).get("builds", [])
    known = {a["url"]: a for b in old for a in b.get("assets", [])}
    fresh = [b for r in releases(up) if (b := build_of(up, r, known))]
    by_version = {b["version"]: b for b in old}
    by_version.update({b["version"]: b for b in fresh})
    builds = sorted(by_version.values(), key=lambda b: (b.get("date", ""), b["version"]), reverse=True)
    # A rolling tag's asset is replaced in place: only its newest build can still match its digest.
    seen: set[str] = set()
    kept = []
    for b in builds:
        urls = {a["url"] for a in b["assets"]}
        if urls & seen:
            continue
        seen |= urls
        kept.append(b)
    entry: dict = {"name": up.name, "kind": up.kind, "builds": kept[:BUILDS_KEPT]}
    for key in ("family", "bin"):
        if getattr(up, key):
            entry[key] = getattr(up, key)
    source, _, where = up.repo.partition(":")
    entry["homepage"] = up.homepage or (f"https://github.com/{where}" if source == "github" else f"https://{where}")
    return entry


def main() -> None:
    parser = argparse.ArgumentParser(description=(__doc__ or "").split("\n", 1)[0])
    parser.add_argument("--previous", help="the catalogue to extend: its pinned builds stay, up to the newest few")
    parser.add_argument("--out", default="-", help="where to write it; - for stdout")
    parser.add_argument("--only", default="", help="comma-separated ids; the others are copied from --previous")
    args = parser.parse_args()
    previous = {"components": {}}
    if args.previous and os.path.exists(args.previous):
        with open(args.previous) as f:
            previous = json.load(f)
    only = {s for s in args.only.split(",") if s}
    components = dict(previous.get("components", {}))
    failed = []
    for up in UPSTREAMS:
        if only and up.id not in only:
            continue
        print(f"{up.id}", file=sys.stderr)
        try:
            entry = component(up, components.get(up.id))
        except Exception as e:  # noqa: BLE001
            print(f"  {up.id}: {e}", file=sys.stderr)
            failed.append(up.id)
            continue
        if entry["builds"]:
            components[up.id] = entry
        else:
            print(f"  {up.id}: no build found", file=sys.stderr)
            failed.append(up.id)
    # Also on the entries kept from --previous: a notice must not wait for its upstream's next good fetch.
    for up in UPSTREAMS:
        if up.id in components:
            kept = {k: v for k, v in components[up.id].items() if k != "notice"}
            components[up.id] = kept | ({"notice": up.notice} if up.notice else {})
    unchanged = components == previous.get("components") and previous.get("schema") == SCHEMA
    generated_at = previous.get("generated_at") if unchanged else datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    catalogue = {"schema": SCHEMA, "generated_at": generated_at, "components": dict(sorted(components.items()))}
    text = json.dumps(catalogue, indent=1, sort_keys=True) + "\n"
    if args.out == "-":
        sys.stdout.write(text)
    else:
        with open(args.out, "w") as f:
            f.write(text)
    if failed:
        print(f"kept the previous entries of: {', '.join(failed)}", file=sys.stderr)


if __name__ == "__main__":
    main()
