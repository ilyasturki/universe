#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
usage: tools/dist OUT

Builds the release tree that install.sh installs from, outside Nix:
  OUT/bin/universe                    the CLI (release, sqlite bundled)
  OUT/bin/universe-desktop            the GTK app, where GTK 4.22 and libadwaita 1.9
                                      are to build it against
  OUT/wheels/                         universe_core (abi3) and universe_ui
  OUT/share/universe/{modules,sources}
  OUT/share/{applications,icons,man,fish,bash-completion,zsh}
  OUT/share/{dbus-1,gnome-shell,metainfo}   the GTK app's
  OUT/share/wayland-sessions/universe.desktop  the Universe login session
  OUT/lib/udev/rules.d/70-universe.rules    /dev/uhid, the virtual pads' hidraw
                                      and /dev/uinput opened to the session
  OUT/lib/modules-load.d/universe.conf      uhid loaded at boot
  OUT/install.sh

Needs cargo and python3 (3.11+) with pip; pip fetches maturin and
setuptools for the wheel builds, python the GOG source's Galaxy service stub
from comet's release. scdoc, when found, adds universe-ui.1 and
universe-desktop.1. UNIVERSE_DESKTOP_BIN names a universe-desktop built
elsewhere to ship instead; without it or the libraries the GTK app is left out.
USAGE
}

case "${1:-}" in
    "" | -h | --help) usage; exit 0 ;;
esac
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p "$1"
out="$(cd "$1" && pwd)"
python="${PYTHON:-python3}"

cargo build --release --locked -p universe --manifest-path "$repo/Cargo.toml"
install -Dm755 "${CARGO_TARGET_DIR:-$repo/target}/release/universe" "$out/bin/universe"

rm -rf "$out/wheels"
"$python" -m pip wheel --quiet --no-deps --wheel-dir "$out/wheels" "$repo/crates/universe-py" "$repo/ui"

for kind in modules sources; do
    rm -rf "${out:?}/share/universe/$kind"
    mkdir -p "$out/share/universe/$kind"
    cp -r "$repo/$kind/." "$out/share/universe/$kind"
    rm -rf "$out/share/universe/$kind"/*/tests "$out/share/universe/$kind"/conftest.py "$out/share/universe/$kind"/test_*.py
    find "$out/share/universe/$kind" -name __pycache__ -prune -exec rm -rf {} +
done
# The flake's galaxyServiceStub: same URL and hash
"$python" - "$out/share/universe/sources/gog/GalaxyCommunication.exe" <<'PY'
import hashlib, sys, urllib.request
url = "https://github.com/imLinguin/comet/releases/download/v0.3.2/GalaxyCommunication-dummy.exe"
data = urllib.request.urlopen(url, timeout=60).read()
if hashlib.sha256(data).hexdigest() != "c7695267da363a861af99db95cafe68b732ae743e5830b4feea1bc7ee745f99d":
    sys.exit(f"dist: {url} does not match its pinned hash")
open(sys.argv[1], "wb").write(data)
PY

gen="$(mktemp -d)"
trap 'rm -rf "$gen"' EXIT
"$out/bin/universe" __generate "$gen"
install -Dm644 "$gen"/man/*.1 -t "$out/share/man/man1"
install -Dm644 "$gen/universe.fish" "$out/share/fish/vendor_completions.d/universe.fish"
install -Dm644 "$gen/universe.bash" "$out/share/bash-completion/completions/universe"
install -Dm644 "$gen/_universe" "$out/share/zsh/site-functions/_universe"
if command -v scdoc >/dev/null; then
    scdoc < "$repo/ui/universe-ui.1.scd" > "$out/share/man/man1/universe-ui.1"
fi

desktop_bin="${UNIVERSE_DESKTOP_BIN:-}"
if [ -z "$desktop_bin" ] && command -v blueprint-compiler > /dev/null && command -v glib-compile-resources > /dev/null \
    && pkg-config --atleast-version=4.22 gtk4 && pkg-config --atleast-version=1.9 libadwaita-1; then
    cargo build --release --locked -p universe-desktop --manifest-path "$repo/Cargo.toml"
    desktop_bin="${CARGO_TARGET_DIR:-$repo/target}/release/universe-desktop"
fi
if [ -n "$desktop_bin" ]; then
    data="$repo/crates/universe-desktop/data"
    id=io.github.ilyasturki.UniverseDesktop
    install -Dm755 "$desktop_bin" "$out/bin/universe-desktop"
    install -Dm644 "$data/$id.desktop" -t "$out/share/applications"
    install -Dm644 "$data/$id.service" -t "$out/share/dbus-1/services"
    install -Dm644 "$data/$id.search-provider.ini" -t "$out/share/gnome-shell/search-providers"
    install -Dm644 "$data/$id.metainfo.xml" -t "$out/share/metainfo"
    install -Dm644 "$data/icons/apps/$id.svg" -t "$out/share/icons/hicolor/scalable/apps"
    install -Dm644 "$data/icons/apps/$id-symbolic.svg" -t "$out/share/icons/hicolor/symbolic/apps"
    if command -v scdoc > /dev/null; then
        scdoc < "$repo/crates/universe-desktop/universe-desktop.1.scd" > "$out/share/man/man1/universe-desktop.1"
    fi
else
    echo "dist: Universe Desktop is left out: it builds against GTK 4.22 and libadwaita 1.9 with blueprint-compiler and glib-compile-resources (or ships UNIVERSE_DESKTOP_BIN)" >&2
fi

install -Dm644 "$repo/ui/universe-ui.desktop" -t "$out/share/applications"
install -Dm644 "$repo/ui/icons/hicolor/scalable/apps/universe-ui.svg" -t "$out/share/icons/hicolor/scalable/apps"
install -Dm644 "$repo/ui/icons/hicolor/symbolic/apps/universe-ui-symbolic.svg" -t "$out/share/icons/hicolor/symbolic/apps"
install -Dm644 "$repo/packaging/system/universe.desktop" -t "$out/share/wayland-sessions"
install -Dm644 "$repo/packaging/system/70-universe.rules" -t "$out/lib/udev/rules.d"
install -Dm644 "$repo/packaging/system/universe.conf" -t "$out/lib/modules-load.d"
install -Dm755 "$repo/install.sh" "$out/install.sh"
install -Dm644 "$repo/LICENSE" "$out/LICENSE"
echo "$out"
