AUTH_URL = "https://auth.gog.com/auth?client_id=46899977096215655&redirect_uri=https%3A%2F%2Fembed.gog.com%2Fon_login_success%3Forigin%3Dclient&response_type=code&layout=client2"
LIBRARY_URL = "https://embed.gog.com/account/getFilteredProducts?mediaType=1&page={page}"
USER_URL = "https://embed.gog.com/userData.json"
CATALOG_URL = "https://catalog.gog.com/v1/catalog"
BUILDS_URL = "https://content-system.gog.com/products/{id}/os/{platform}/builds?generation=2"
ACHIEVEMENTS_URL = "https://gameplay.gog.com/clients/{client}/users/{user}/achievements"
GALAXY_CLIENT_ID = "46899977096215655"
USER_AGENT = "universe-gog/0.1"
HTTP_TIMEOUT_S = 30
COMET_UNIT = "universe-comet.service"
COMET_PORT = 9977  # hardcoded in comet: one instance at a time
COMET_READY_S = 5
COMET_IDLE_S = 10
WATCH_INTERVAL_S = 2.0
GALAXY_LIBS = {"galaxy.dll", "galaxy64.dll", "libgalaxy.so", "libgalaxy64.so"}
GALAXY_DEPTH = 4  # Unity keeps it under <Game>_Data/Plugins/x86_64/
GALAXY_SERVICE_EXE = r"C:\ProgramData\GOG.com\Galaxy\redists\GalaxyCommunication.exe"
GALAXY_PATHS_KEY = r"HKLM\SOFTWARE\WOW6432Node\GOG.com\GalaxyClient\paths"
WINE_STEP_S = 10  # two steps, a token refresh and comet's start fit the pre-launch timeout_s, which cancels the launch
GOGDL_JSON_TIMEOUT_S = 120
KILL_GRACE_S = 10
PROGRESS_INTERVAL_S = 1.0
PROGRESS_RE = re.compile(r"Progress: ([\d.]+) (\d+)/(\d+)")
CRITICAL_MARK = "[TASK_EXEC] CRITICAL"
INFO_RE = re.compile(r"^goggame-(\d+)\.info$")
LOCALE_RE = re.compile(r"^([a-z]{2})_([A-Z]{2})\b")
RESUME_FILE = ".gogdl-resume"  # gogdl appends a line per finished file, removes it when the download completes
SCAN_DEPTH = 5  # a .info can sit under a wine prefix: gog/<slug>/drive_c/GOG Games/<Game>/

_child = None


class SourceError(Exception):
    pass


def emit(event, **fields):
    print(json.dumps({"event": event, **fields}), flush=True)


def log(message):
    print(f"gog: {message}", file=sys.stderr, flush=True)


def data_dir():
    path = Path(os.environ["SOURCE_DATA_DIR"])
    path.mkdir(parents=True, exist_ok=True)
    return path


def load_settings():
    settings = json.loads(os.environ["SOURCE_SETTINGS_JSON"])
    for key in ("games_dir", "auth_path"):
        settings[key] = os.path.expanduser(str(settings[key]))
    dirs = [d.strip() for d in settings["scan_dirs"].split(",") if d.strip()]
    settings["scan_dirs"] = [os.path.expanduser(d) for d in dirs] or [settings["games_dir"]]
    settings["install_timeout_s"] = int(settings["install_timeout_s"])
    settings["achievements"] = bool(settings.get("achievements", True))
    return settings


def platform_args(settings):
    return ["--platform", settings["platform"], "--with-dlcs" if settings["with_dlcs"] else "--skip-dlcs"]


def fetch(url, token=None, headers=None):
    request = urllib.request.Request(url, headers=request_headers(token, headers))
    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT_S) as response:
            return json.load(response)
    except (OSError, ValueError) as exc:
        raise SourceError(f"GET {url.split('?')[0]}: {exc}") from exc


def fetch_bytes(url):
    request = urllib.request.Request(url, headers=request_headers(None, None))
    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT_S) as response:
            return response.read()
    except OSError as exc:
        raise SourceError(f"GET {url.split('?')[0]}: {exc}") from exc


def request_headers(token, extra):
    headers = {"User-Agent": USER_AGENT, "Accept": "application/json", **(extra or {})}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return headers


def ensure_auth_file(path):
    # gogdl json.loads() the file whenever the path exists, so it must hold at least "{}".
    auth = Path(path)
    auth.parent.mkdir(parents=True, exist_ok=True)
    if not auth.exists() or auth.stat().st_size == 0:
        auth.write_text("{}")


def gogdl_command(settings, *args):
    ensure_auth_file(settings["auth_path"])
    return ["gogdl", "--auth-config-path", settings["auth_path"], *args]


def gogdl_env():
    env = dict(os.environ)
    # gogdl's manifest cache is keyed by id alone, ignores --path, and a stale one truncates real files.
    env["GOGDL_CONFIG_PATH"] = str(data_dir() / "gogdl")
    return env


def gogdl_json(settings, *args):
    try:
        proc = subprocess.run(gogdl_command(settings, *args), env=gogdl_env(), capture_output=True, text=True, timeout=GOGDL_JSON_TIMEOUT_S, check=False)
    except FileNotFoundError:
        raise SourceError("gogdl is not installed") from None
    except subprocess.TimeoutExpired:
        raise SourceError(f"gogdl {args[0]} timed out after {GOGDL_JSON_TIMEOUT_S}s") from None
    for line in proc.stderr.splitlines():
        log(line)
    if proc.returncode != 0:
        raise SourceError(f"gogdl {args[0]} failed (exit {proc.returncode})")
    try:
        return json.loads(proc.stdout)
    except ValueError:
        raise SourceError(f"gogdl {args[0]} printed no JSON") from None


def kill_group(proc):
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        proc.wait(timeout=KILL_GRACE_S)
    except subprocess.TimeoutExpired:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()


def gogdl_stream(settings, *args, timeout):
    global _child  # noqa: PLW0603
    try:
        proc = subprocess.Popen(
            gogdl_command(settings, *args),
            env=gogdl_env(),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors="replace",
            start_new_session=True,
        )
    except FileNotFoundError:
        raise SourceError("gogdl is not installed") from None
    _child = proc
    stdout = proc.stdout
    assert stdout is not None
    lines = queue.Queue()

    def pump():
        for line in stdout:
            lines.put(line.rstrip("\n"))
        lines.put(None)

    threading.Thread(target=pump, daemon=True).start()
    deadline = time.monotonic() + timeout
    last_emit = 0.0
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                kill_group(proc)
                raise SourceError(f"gogdl {args[0]} exceeded {timeout}s, killed")
            try:
                line = lines.get(timeout=min(remaining, PROGRESS_INTERVAL_S))
            except queue.Empty:
                continue
            if line is None:
                break
            if CRITICAL_MARK in line:
                log(line)
                kill_group(proc)
                raise SourceError(f"gogdl {args[0]} reported a fatal error, killed")
            match = PROGRESS_RE.search(line)
            if not match:
                log(line)
                continue
            done, total = int(match.group(2)), int(match.group(3))
            now = time.monotonic()
            if now - last_emit >= PROGRESS_INTERVAL_S or done >= total:
                emit("progress", done=done, total=total, message=f"{match.group(1)}%")
                last_emit = now
        code = proc.wait()
    finally:
        _child = None
    if code != 0:
        raise SourceError(f"gogdl {args[0]} failed (exit {code})")


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_json(path, data):
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data))
    tmp.replace(path)


def library_index():
    # The core writes library.json (its game events) after every `library`; the source only reads it.
    products = load_json(data_dir() / "library.json")
    return None if not isinstance(products, list) else {str(p.get("id")): p for p in products}


def partials_path():
    return data_dir() / "partials.json"


def load_partials():
    partials = load_json(partials_path())
    return partials if isinstance(partials, dict) else {}


def partial_of(game_id, partials=None):
    entry = (partials if partials is not None else load_partials()).get(game_id)
    if not entry or not entry.get("dir"):
        return None
    folder = Path(entry["dir"])
    if not (folder / RESUME_FILE).exists():
        return None
    return {"dir": str(folder), "bytes": folder_size(folder), "download_size": entry.get("download_size"), "disk_size": entry.get("disk_size")}


def set_partial(game_id, entry):
    partials = load_partials()
    if entry is None:
        partials.pop(game_id, None)
    else:
        partials[game_id] = entry
    save_json(partials_path(), partials)


def folder_size(folder):
    total = 0
    for root, _dirs, files in os.walk(folder):
        for name in files:
            with contextlib.suppress(OSError):
                total += os.lstat(os.path.join(root, name)).st_size
    return total


def size_total(sizes, lang="en-US"):
    if not isinstance(sizes, dict) or not sizes:
        return None
    langs = [k for k in sizes if k != "*"]
    picked = [k for k in ("*", lang if lang in sizes else (langs[0] if langs else None)) if k in sizes]
    return {key: sum(int((sizes[k] or {}).get(key) or 0) for k in picked) for key in ("download_size", "disk_size")}


def size_info(settings, game_id):
    data = gogdl_json(settings, "info", game_id, *platform_args(settings))
    total = size_total(data.get("size") if isinstance(data, dict) else None) or {}
    if settings["with_dlcs"]:
        for dlc in (data.get("dlcs") or []) if isinstance(data, dict) else []:
            for key, value in (size_total(dlc.get("size")) or {}).items():
                total[key] = total.get(key, 0) + value
    return data, total


def access_token(settings):
    creds = gogdl_json(settings, "auth")
    token = creds.get("access_token") if isinstance(creds, dict) else None
    if not token:
        raise SourceError("not logged in to GOG (run login)")
    return token


def fetch_library(settings):
    token = access_token(settings)
    products, page = [], 1
    while True:
        data = fetch(LIBRARY_URL.format(page=page), token)
        products.extend(data.get("products") or [])
        if page >= int(data.get("totalPages") or 1):
            return products
        page += 1


def product_year(product):
    if product and isinstance(product.get("release_year"), int):
        return product["release_year"]
    date = product.get("releaseDate") if product else None
    if isinstance(date, dict):
        date = date.get("date")
    date = str(date or "")
    return int(date[:4]) if date[:4].isdigit() else None


def product_image(product):
    image = product.get("image") if product else None
    if image and image.startswith("//"):
        return f"https:{image}.jpg"
    return (product or {}).get("coverVertical") or image or None


def fetch_build(settings, game_id):
    data = fetch(BUILDS_URL.format(id=game_id, platform=settings["platform"]))
    items = [b for b in data.get("items") or [] if b.get("branch") is None]
    if not items:
        return None
    last = max(reversed(items), key=lambda b: b.get("date_published") or "")
    return {"build": str(last.get("build_id")), "version": last.get("version_name") or "?", "date": str(last.get("date_published") or "")[:10]}


def fetch_builds(settings, game_ids):
    def one(game_id):
        try:
            return game_id, fetch_build(settings, game_id)
        except SourceError as exc:
            log(str(exc))
            return game_id, None

    with ThreadPoolExecutor(max_workers=8) as pool:
        return dict(pool.map(one, game_ids))


def find_info_files(root):
    stack = [(Path(root), 1)]
    while stack:
        folder, depth = stack.pop()
        try:
            with os.scandir(folder) as it:
                entries = sorted(it, key=lambda e: e.name)
        except OSError:
            continue
        infos = [Path(e.path) for e in entries if e.is_file() and INFO_RE.match(e.name)]
        if infos:
            yield folder, infos
            continue
        if depth >= SCAN_DEPTH:
            continue
        stack.extend((Path(entry.path), depth + 1) for entry in entries if entry.is_dir(follow_symlinks=False) and not entry.name.startswith("."))


def read_info(path):
    with open(path, encoding="utf-8-sig") as f:
        return json.load(f)


def primary_exe(info):
    for task in info.get("playTasks") or []:
        if task.get("isPrimary") and task.get("type") == "FileTask":
            return task.get("path") or None
    return None


def scan_installs(settings, roots=None):
    installs, seen = [], set()
    partial_dirs = {str(e.get("dir")) for e in load_partials().values()}
    if roots is None:
        roots = list(dict.fromkeys([*settings["scan_dirs"], settings["games_dir"]]))
    for root in roots:
        for folder, paths in sorted(find_info_files(root)):
            # A stopped first download is not an install; a stopped update leaves the old build in place.
            if (folder / RESUME_FILE).exists() and str(folder) in partial_dirs:
                log(f"{folder}: download not finished, skipped")
                continue
            infos = []
            for path in paths:
                try:
                    infos.append(read_info(path))
                except (OSError, ValueError) as exc:
                    log(f"unreadable {path}: {exc}")
            bases = [i for i in infos if i.get("gameId") and str(i["gameId"]) == str(i.get("rootGameId"))]
            if not bases:
                log(f"{folder}: no base game, skipped")
                continue
            for base in bases:
                game_id = str(base["gameId"])
                if game_id in seen:
                    log(f"{folder}: {game_id} already found elsewhere, skipped")
                    continue
                seen.add(game_id)
                dlcs = sorted(str(i["gameId"]) for i in infos if i is not base and i.get("gameId") and str(i.get("rootGameId")) == game_id)
                build = base.get("buildId")
                installs.append(
                    {
                        "id": game_id,
                        "title": base.get("name") or game_id,
                        "dir": str(folder),
                        "exe": primary_exe(base),
                        "build": str(build) if build else None,
                        "dlcs": dlcs,
                        "disk_size": folder_size(folder),
                    }
                )
    return installs


def find_install(settings, game_id, roots):
    return next((i for i in scan_installs(settings, roots) if i["id"] == game_id), None)


def game_event(game_id, title, owned, install=None, product=None, partials=None):
    fields = {}
    if install:
        fields["disk_size"] = install.get("disk_size")
    else:
        partial = partial_of(game_id, partials)
        if partial:
            fields.update(partial_dir=partial["dir"], partial_bytes=partial["bytes"])
            fields.update({k: partial[k] for k in ("download_size", "disk_size") if partial.get(k)})
    emit(
        "game",
        id=game_id,
        title=title,
        owned=owned,
        installed=install is not None,
        dir=install["dir"] if install else None,
        exe=install["exe"] if install else None,
        build=install["build"] if install else None,
        dlcs=install["dlcs"] if install else [],
        release_year=product_year(product),
        image=product_image(product),
        **fields,
    )


def owned_status(game_id, index):
    return (game_id in index) if index is not None else None


def require_id(args, verb):
    if not args or not args[0].strip():
        raise SourceError(f"usage: {verb} <id>")
    return args[0].strip()


def cmd_login(settings, args):
    if not args:
        emit("login_url", url=AUTH_URL)
        emit("done")
        return
    creds = gogdl_json(settings, "auth", "--code", args[0])
    if not isinstance(creds, dict) or creds.get("error") or not creds.get("access_token"):
        raise SourceError("GOG rejected the authorization code")
    user = fetch(USER_URL, creds["access_token"])
    remember_user(username=user.get("username") or "")
    emit("logged_in", user=user.get("username") or "")
    emit("done")


def cmd_status(settings, args):
    try:
        token = access_token(settings)
    except SourceError:
        emit("done")
        return
    try:
        user = fetch(USER_URL, token).get("username") or ""
    except Exception:  # noqa: BLE001
        user = ""
    if user:
        remember_user(username=user)
    emit("logged_in", user=user)
    emit("done")


def cmd_library(settings, args):
    products = fetch_library(settings)
    installs = {i["id"]: i for i in scan_installs(settings)}
    partials = load_partials()
    for product in products:
        game_id = str(product.get("id"))
        game_event(game_id, product.get("title") or game_id, True, installs.get(game_id), product, partials)
    emit("done")


def cmd_search(settings, args):
    text = " ".join(args).strip()
    if not text:
        raise SourceError("usage: search <text>")
    query = urllib.parse.urlencode({"query": f"like:{text}", "productType": "in:game", "limit": "20"}, quote_via=urllib.parse.quote)
    data = fetch(f"{CATALOG_URL}?{query}")
    index = library_index()
    installs = {i["id"]: i for i in scan_installs(settings)}
    for product in data.get("products") or []:
        game_id = str(product.get("id"))
        game_event(game_id, product.get("title") or game_id, owned_status(game_id, index), installs.get(game_id), product)
    emit("done")


def cmd_info(settings, args):
    game_id = require_id(args, "info")
    data, total = size_info(settings, game_id)
    emit("info", data=data, **total)
    emit("done")


def cmd_install(settings, args):
    game_id = require_id(args, "install")
    games_dir = settings["games_dir"]
    os.makedirs(games_dir, exist_ok=True)
    index = library_index()
    if index is not None and game_id not in index:
        log(f"{game_id} is not in the cached library; gogdl may refuse it")
    # gogdl resumes from <games_dir>/<folder_name>/.gogdl-resume; the folder is only known through `info`.
    data, total = size_info(settings, game_id)
    folder = data.get("folder_name") if isinstance(data, dict) else None
    if folder:
        title = ((index or {}).get(game_id) or {}).get("title") or folder
        set_partial(game_id, {"dir": os.path.join(games_dir, folder), "title": title, **total})
    gogdl_stream(settings, "download", game_id, *platform_args(settings), "--path", games_dir, timeout=settings["install_timeout_s"])
    install = find_install(settings, game_id, [games_dir])
    if install is None:
        raise SourceError(f"gogdl finished but no goggame-{game_id}.info under {games_dir}")
    set_partial(game_id, None)
    game_event(game_id, install["title"], True, install, (index or {}).get(game_id))
    emit("done")


def cmd_update(settings, args):
    installs = scan_installs(settings)
    index = library_index()
    if not args:
        remotes = fetch_builds(settings, [i["id"] for i in installs])
        for install in installs:
            remote = remotes.get(install["id"])
            if remote is None:
                log(f"{install['title']}: no build published for {settings['platform']}, skipped")
            elif install["build"] == remote["build"]:
                continue
            elif owned_status(install["id"], index) is False:
                log(f"{install['title']}: {remote['version']} available but not in the library, skipped")
            else:
                emit(
                    "update",
                    id=install["id"],
                    title=install["title"],
                    local_build=install["build"],
                    remote_build=remote["build"],
                    version=remote["version"],
                    date=remote["date"],
                )
        emit("done")
        return
    game_id = require_id(args, "update")
    install = next((i for i in installs if i["id"] == game_id), None)
    if install is None:
        raise SourceError(f"{game_id} is not installed under {', '.join(settings['scan_dirs'])}")
    if owned_status(game_id, index) is False:
        raise SourceError(f"{install['title']} is not in the GOG library, refusing to update")
    remote = fetch_build(settings, game_id)
    if remote is None:
        raise SourceError(f"no build published for {game_id} on {settings['platform']}")
    if install["build"] == remote["build"]:
        log(f"{install['title']} is already current ({remote['version']})")
        emit("done")
        return
    log(f"{install['title']}: {install['build'] or 'unknown'} -> {remote['build']} ({remote['version']})")
    gogdl_stream(settings, "update", game_id, *platform_args(settings), "--path", install["dir"], timeout=settings["install_timeout_s"])
    after = find_install(settings, game_id, [install["dir"]])
    if after is None or after["build"] != remote["build"]:
        raise SourceError(f"gogdl finished but {install['title']} is at build {after['build'] if after else 'unknown'}, expected {remote['build']}")
    game_event(game_id, after["title"], True, after, (index or {}).get(game_id))
    emit("done")


def cmd_scan(settings, args):
    index = library_index()
    installs = scan_installs(settings)
    for install in installs:
        game_event(install["id"], install["title"], owned_status(install["id"], index), install, (index or {}).get(install["id"]))
    partials = load_partials()
    found = {i["id"] for i in installs}
    for game_id, entry in partials.items():
        if game_id not in found and partial_of(game_id, partials):
            product = (index or {}).get(game_id)
            game_event(game_id, entry.get("title") or (product or {}).get("title") or game_id, owned_status(game_id, index), None, product, partials)
    emit("done")


def user_path():
    return data_dir() / "user.json"


def remembered_user():
    user = load_json(user_path())
    return user if isinstance(user, dict) else {}


def remember_user(**fields):
    save_json(user_path(), {**remembered_user(), **fields})


def galaxy_creds(settings):
    creds = gogdl_json(settings, "auth")
    if not isinstance(creds, dict) or not creds.get("access_token") or not creds.get("user_id"):
        raise SourceError("not logged in to GOG (run login)")
    remember_user(user_id=str(creds["user_id"]))
    return creds


def clients_path():
    return data_dir() / "clients.json"


# A game's Galaxy client id and secret sit in its build manifest; they never change, so they are kept.
def game_client(settings, game_id):
    clients = load_json(clients_path())
    clients = clients if isinstance(clients, dict) else {}
    if game_id in clients:
        return clients[game_id]
    manifest = None
    for platform in dict.fromkeys([settings["platform"], "windows"]):
        builds = fetch(BUILDS_URL.format(id=game_id, platform=platform)).get("items") or []
        if builds:
            raw = fetch_bytes(builds[0]["link"])
            with contextlib.suppress(zlib.error):
                raw = zlib.decompress(raw)
            manifest = json.loads(raw)
            break
    if not manifest or not manifest.get("clientId") or not manifest.get("clientSecret"):
        raise SourceError(f"{game_id} has no Galaxy client: its builds name none")
    client = {"client_id": manifest["clientId"], "client_secret": manifest["clientSecret"]}
    clients[game_id] = client
    save_json(clients_path(), clients)
    return client


# GOG names the 60 px thumbnail (`…_gac_60.jpg`); the bare name is the 256 px original.
def full_icon(url):
    return re.sub(r"_gac_\d+(?=\.\w+$)", "", url or "")


def achievement_event(item):
    emit(
        "achievement",
        key=item.get("achievement_key") or "",
        name=item.get("name") or "",
        description=item.get("description") or "",
        unlocked_at=item.get("date_unlocked") or "",
        hidden=not item.get("visible", True),
        icon=full_icon(item.get("image_url_unlocked")),
        icon_locked=full_icon(item.get("image_url_locked")),
        rarity=item.get("rarity"),
    )


def cmd_achievements(settings, args):
    game_id = require_id(args, "achievements")
    user_id = galaxy_creds(settings)["user_id"]
    client = game_client(settings, game_id)
    creds = gogdl_json(settings, "auth", "--client-id", client["client_id"], "--client-secret", client["client_secret"])
    token = creds.get("access_token") if isinstance(creds, dict) else None
    if not token:
        raise SourceError(f"GOG refused a token for {game_id}'s Galaxy client")
    url = ACHIEVEMENTS_URL.format(client=client["client_id"], user=user_id)
    locale = LOCALE_RE.match(os.environ.get("LANG", ""))
    lang = {"X-Gog-Lc": f"{locale.group(1)}-{locale.group(2)}" if locale else "en-US"}
    page, seen = None, 0
    while True:
        data = fetch(url + (f"?page_token={urllib.parse.quote(page)}" if page else ""), token, lang)
        items = data.get("items") or []
        for item in items:
            achievement_event(item)
        seen += len(items)
        page = data.get("page_token") or None
        if not items or not page or seen >= int(data.get("total_count") or 0):
            break
    emit("done")


def has_galaxy(game_dir):
    if not game_dir:
        return False
    stack = [(Path(game_dir), 1)]
    while stack:
        folder, depth = stack.pop()
        try:
            with os.scandir(folder) as it:
                entries = list(it)
        except OSError:
            continue
        if any(e.name.lower() in GALAXY_LIBS for e in entries if e.is_file()):
            return True
        if depth < GALAXY_DEPTH:
            stack.extend((Path(e.path), depth + 1) for e in entries if e.is_dir(follow_symlinks=False))
    return False


def data_home():
    return Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share")


def session_path():
    return data_dir() / "comet-session.json"


def systemctl(*args):
    subprocess.run(["systemctl", "--user", "--quiet", *args], capture_output=True, check=False, timeout=10)


def port_open(port):
    with contextlib.suppress(OSError), socket.create_connection(("127.0.0.1", port), timeout=0.5):
        return True
    return False


# comet reads Heroic's auth.json, which is gogdl's format; XDG_CONFIG_PATH (sic) points it at ours, so no token rides on a command line.
def comet_config(settings):
    root = data_dir() / "comet"
    link = root / "heroic" / "gog_store" / "auth.json"
    link.parent.mkdir(parents=True, exist_ok=True)
    if not link.is_symlink() or os.readlink(link) != settings["auth_path"]:
        link.unlink(missing_ok=True)
        link.symlink_to(settings["auth_path"])
    return root


def start_comet(settings, comet, username):
    systemctl("stop", COMET_UNIT)
    subprocess.run(
        [
            "systemd-run",
            "--user",
            "--quiet",
            "--collect",
            f"--unit={COMET_UNIT}",
            f"--setenv=XDG_CONFIG_PATH={comet_config(settings)}",
            f"--setenv=XDG_DATA_HOME={data_home()}",
            f"--setenv=COMET_IDLE_WAIT={COMET_IDLE_S}",
            comet,
            "--from-heroic",
            "--username",
            username,
            "-q",
        ],
        capture_output=True,
        check=True,
        timeout=10,
    )
    deadline = time.monotonic() + COMET_READY_S
    while not port_open(COMET_PORT) and time.monotonic() < deadline:
        time.sleep(0.1)


def wine_command(game):
    effective, launch = game.get("effective") or {}, game.get("launch") or {}
    env = {"WINEPREFIX": effective.get("prefix") or ""}
    if effective.get("runner_kind") == "proton":
        env.update(
            PROTONPATH=effective.get("proton_path") or "",
            GAMEID=launch.get("umu_id") or "umu-default",
            STORE="gog",
            PROTON_VERB="run",
            UMU_RUNTIME_UPDATE="0",
        )
        return effective.get("runner_path") or "umu-run", env
    if effective.get("runner_kind") == "wine":
        if launch.get("arch"):
            env["WINEARCH"] = launch["arch"]
        return effective.get("runner_path") or "wine", env
    return None, env


# Under gamescope the hook inherits its CAP_SYS_NICE, which Proton's bwrap refuses: the user manager runs the step clean, as it does the game.
def wine_step(program, env, *args):
    setenv = [f"--setenv={k}={v}" for k, v in {"PATH": os.environ.get("PATH", ""), **env}.items()]
    command = ["systemd-run", "--user", "--wait", "--pipe", "--quiet", "--collect", f"--property=RuntimeMaxSec={WINE_STEP_S}", *setenv, program, *args]
    try:
        subprocess.run(command, capture_output=True, check=True, timeout=WINE_STEP_S + 2)
    except (OSError, subprocess.SubprocessError) as exc:
        output = getattr(exc, "stderr", None) or getattr(exc, "stdout", None) or b""
        tail = " | ".join(output.decode(errors="replace").strip().splitlines()[-6:])
        log(f"{args[0]} in the prefix: {exc}" + (f": {tail}" if tail else ""))
        return False
    return True


# Some games talk to comet only once Galaxy's service is registered in their prefix: comet ships a stand-in that does nothing.
def install_galaxy_service():
    game = json.loads(os.environ.get("UNIVERSE_GAME_JSON") or "{}")
    program, env = wine_command(game)
    if program is None:
        return
    prefix = Path(env["WINEPREFIX"])
    stub = Path(os.environ.get("SOURCE_DIR", "")) / "GalaxyCommunication.exe"
    if not stub.is_file():
        log(f"{stub} is missing: no Galaxy service for games that look for one")
        return
    if not (prefix / "drive_c" / "windows").is_dir():
        log("the prefix is not made yet: the Galaxy service comes with the next launch")
        return
    target = prefix / "drive_c" / "ProgramData" / "GOG.com" / "Galaxy" / "redists" / "GalaxyCommunication.exe"
    if not target.exists():
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(stub, target)
    try:
        registry = (prefix / "system.reg").read_text(errors="replace").lower()
    except OSError:
        registry = ""
    if "\\\\services\\\\galaxycommunication]" not in registry and not wine_step(
        program, env, "sc", "create", "GalaxyCommunication", f"binpath={GALAXY_SERVICE_EXE}"
    ):
        return
    if "\\\\galaxyclient\\\\paths]" not in registry:
        wine_step(program, env, "reg", "add", GALAXY_PATHS_KEY, "/v", "client", "/t", "REG_SZ", "/d", r"C:\Program Files\GOG Galaxy", "/f")


def wants_comet(settings):
    if not settings["achievements"]:
        return None
    comet = shutil.which("comet")
    if comet is None:
        log("comet is not installed: no achievements this session")
        return None
    if not has_galaxy(os.environ.get("GAME_DIR", "")):
        return None
    if not ((load_json(settings["auth_path"]) or {}).get(GALAXY_CLIENT_ID) or {}).get("refresh_token"):
        log("not logged in to GOG: no achievements this session")
        return None
    return comet


def hook_pre_launch(settings):
    comet = wants_comet(settings)
    if comet is None:
        return
    try:
        galaxy_creds(settings)
    except SourceError as exc:
        log(f"{exc}: comet runs on the tokens it has")
    try:
        install_galaxy_service()
    except (OSError, ValueError) as exc:
        log(f"Galaxy service: {exc}")
    user = remembered_user()
    user_id = user.get("user_id") or ""
    try:
        start_comet(settings, comet, user.get("username") or "Universe")
    except (OSError, subprocess.SubprocessError) as exc:
        log(f"comet did not start: {exc}")
        return
    save_json(session_path(), {"session": os.environ.get("SESSION_ID", ""), "user_id": user_id, "data_home": str(data_home())})


def unlocked_rows(db):
    uri = f"file:{db}?mode=ro"
    with contextlib.closing(sqlite3.connect(uri, uri=True, timeout=1)) as con:
        con.row_factory = sqlite3.Row
        return con.execute(
            "SELECT key, name, description, unlock_time, visible_while_locked, image_url_unlocked, image_url_locked, rarity "
            "FROM achievement WHERE unlock_time IS NOT NULL AND unlock_time != ''"
        ).fetchall()


def parse_time(value):
    try:
        at = datetime.fromisoformat(value)
    except ValueError:
        return None
    return at if at.tzinfo else at.replace(tzinfo=UTC)


def report_unlock(row, at):
    item = {
        "key": row["key"],
        "name": row["name"],
        "description": row["description"],
        "unlocked_at": at,
        "hidden": not row["visible_while_locked"],
        "icon": full_icon(row["image_url_unlocked"]),
        "icon_locked": full_icon(row["image_url_locked"]),
        "rarity": row["rarity"],
    }
    proc = subprocess.run(
        [os.environ["UNIVERSE_BIN"], "achievement-unlocked", os.environ["GAME_ID"], json.dumps(item)], capture_output=True, text=True, check=False
    )
    if proc.returncode != 0:
        log(f"achievement-unlocked {row['key']}: {proc.stderr.strip()}")


# Bound to the game's unit: watches comet's store for the unlocks of this session and files each at once.
def hook_post_launch(settings):
    session = load_json(session_path()) or {}
    if session.get("session") != os.environ.get("SESSION_ID") or not session.get("user_id"):
        return
    try:
        client = game_client(settings, os.environ["SOURCE_GAME_ID"])
    except (SourceError, KeyError, ValueError) as exc:
        log(f"no achievements to watch: {exc}")
        return
    db = Path(session["data_home"]) / "comet" / "gameplay" / client["client_id"] / session["user_id"] / "gameplay.db"
    started = parse_time(os.environ.get("SESSION_STARTED_AT", ""))
    seen, first = set(), True
    # The game's end stops this unit: the only way out, so not a failure.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    while True:
        rows = None
        if db.exists():
            try:
                rows = unlocked_rows(db)
            except sqlite3.Error as exc:
                log(f"{db}: {exc}")
        for row in rows or []:
            if row["key"] in seen:
                continue
            seen.add(row["key"])
            at = parse_time(row["unlock_time"] or "")
            fresh = started is not None and at is not None and at >= started
            if first and started is not None and not fresh:
                continue
            # The time is the game's own: one that sends 0 lands in 1970, yet the key only appeared now.
            report_unlock(row, row["unlock_time"] if fresh or started is None else datetime.now(UTC).isoformat(timespec="seconds"))
        if rows is not None:
            first = False
        time.sleep(WATCH_INTERVAL_S)


def hook_session_end(settings):
    if (load_json(session_path()) or {}).get("session") == os.environ.get("SESSION_ID"):
        systemctl("--no-block", "stop", COMET_UNIT)


def hook_post_process(settings):
    if not settings["achievements"] or not has_galaxy(os.environ.get("GAME_DIR", "")):
        return
    proc = subprocess.run(
        [os.environ["UNIVERSE_BIN"], "achievements", os.environ["GAME_ID"], "--refresh", "--json"], capture_output=True, text=True, check=False
    )
    if proc.returncode != 0:
        log(f"achievements refresh: {proc.stderr.strip()}")


VERBS = {
    "login": cmd_login,
    "status": cmd_status,
    "library": cmd_library,
    "search": cmd_search,
    "info": cmd_info,
    "install": cmd_install,
    "update": cmd_update,
    "scan": cmd_scan,
    "achievements": cmd_achievements,
}

# Run by bin/<hook>: a session goes on whatever they meet, so each logs and returns.
HOOKS = {
    "pre-launch": hook_pre_launch,
    "post-launch": hook_post_launch,
    "session-end": hook_session_end,
    "post-process": hook_post_process,
}


def on_signal(signum, frame):
    if _child is not None:
        kill_group(_child)
    sys.exit(128 + signum)


def main(argv):
    if argv and argv[0] in HOOKS:
        try:
            HOOKS[argv[0]](load_settings())
        except (SourceError, OSError, subprocess.SubprocessError) as exc:
            log(f"{argv[0]}: {exc}")
        return 0
    if not argv or argv[0] not in VERBS:
        log(f"usage: source {{{'|'.join(VERBS)}}} [args]")
        return 2
    try:
        settings = load_settings()
        VERBS[argv[0]](settings, argv[1:])
    except SourceError as exc:
        log(str(exc))
        return 1
    return 0


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    sys.exit(main(sys.argv[1:]))
