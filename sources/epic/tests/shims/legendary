#!/usr/bin/env python3
# legendary as the source drives it: its state is installed.json and user.json under LEGENDARY_CONFIG_PATH.
import json, os, sys, time
from pathlib import Path

args = sys.argv[1:]
config = Path(os.environ["LEGENDARY_CONFIG_PATH"])
config.mkdir(parents=True, exist_ok=True)
with open(os.environ["SHIM_LOG"], "a") as f:
    f.write(json.dumps({"args": args, "config": str(config)}) + "\n")
yes = args[0] == "-y"
if yes:
    args = args[1:]
verb, rest = args[0], args[1:]
mode = os.environ.get("SHIM_MODE", "ok")
user = config / "user.json"
installed_path = config / "installed.json"
installed = json.loads(installed_path.read_text()) if installed_path.exists() else {}


def err(message):
    print(f"[cli] ERROR: {message}", file=sys.stderr, flush=True)


def save():
    installed_path.write_text(json.dumps(installed))


def install_entry(app, title, version, path, exe, size):
    entry = {"app_name": app, "title": title, "version": version, "install_path": path, "executable": exe, "install_size": size}
    return {**entry, "is_dlc": False, "platform": "Windows"}


if mode == "signedout" and verb in ("list", "achievements"):
    print("[cli] INFO: Logging in...", file=sys.stderr)
    print("Traceback (most recent call last):", file=sys.stderr)
    print('  File "core.py", line 218, in _login', file=sys.stderr)
    print("ValueError: No saved credentials", file=sys.stderr)
    sys.exit(1)
if verb == "status":
    print(json.dumps({"account": json.loads(user.read_text())["displayName"] if user.exists() else "<not logged in>", "games_available": 2}))
elif verb == "auth":
    if "--delete" in rest:
        user.unlink(missing_ok=True)
    elif user.exists():
        print("[cli] INFO: Stored credentials are still valid", file=sys.stderr)
    elif rest[rest.index("--code") + 1] == "good":
        user.write_text(json.dumps({"displayName": "Yasso"}))
    else:
        err("Login attempt failed, please see log for details.")
elif verb == "list" and "--json" in rest:
    print(json.dumps(json.loads(os.environ["SHIM_LIBRARY"])))
elif verb == "list-installed":
    if "--csv" in rest:
        print("App name,App title,Installed version,Available version,Update available,Install size,Install path,Platform")
        for app, g in installed.items():
            latest = os.environ.get("SHIM_LATEST", g["version"])
            print(f"{app},{g['title']},{g['version']},{latest},{latest != g['version']},{g['install_size']},{g['install_path']},Windows")
    else:
        print(json.dumps(list(installed.values())))
elif verb == "info":
    print(json.dumps({"game": {"app_name": rest[0]}, "install": None, "manifest": {"download_size": 2097152, "disk_size": 4194304}}))
elif verb in ("install", "update"):
    app = rest[0]
    if mode == "fail":
        err("Failed to acquire installed data lock")
        sys.exit(0)
    if verb == "install":
        folder = Path(rest[rest.index("--base-path") + 1]) / os.environ.get("SHIM_FOLDER", app)
    else:
        folder = Path(installed[app]["install_path"])
    folder.mkdir(parents=True, exist_ok=True)
    print("[cli] INFO: Install size: 4.00 MiB", file=sys.stderr, flush=True)
    print("[cli] INFO: Download size: 2.00 MiB (Compression savings: 50.0%)", file=sys.stderr, flush=True)
    if mode == "partial":
        (config / "tmp").mkdir(exist_ok=True)
        (config / "tmp" / f"{app}.resume").write_text("x")
        (folder / "part.bin").write_bytes(b"x" * 300)
        print("[DLManager] INFO: = Progress: 25.00% (1/4), Running for 00:00:01, ETA: 00:00:03", file=sys.stderr, flush=True)
        time.sleep(60)
        sys.exit(0)
    for percent, n in (("50.00", 2), ("100.00", 4)):
        print(f"[DLManager] INFO: = Progress: {percent}% ({n}/4), Running for 00:00:01, ETA: 00:00:01", file=sys.stderr, flush=True)
    (folder / "Game.exe").write_bytes(b"MZ")
    (config / "tmp" / f"{app}.resume").unlink(missing_ok=True)
    installed[app] = install_entry(app, "Hades", os.environ.get("SHIM_LATEST", "1.0"), str(folder), "x64\\Hades.exe", 4194304)
    save()
elif verb == "uninstall":
    if rest[0] in installed:
        import shutil

        shutil.rmtree(installed.pop(rest[0])["install_path"], ignore_errors=True)
        save()
elif verb == "import":
    app, path = rest[0], rest[1]
    if not user.exists():
        err("Log in failed!")
        sys.exit(0)
    installed[app] = install_entry(app, "Imported", "7", path, "Game.exe", 10)
    save()
elif verb == "launch":
    if mode == "offline" and "--offline" not in rest:
        err("Login failed, cannot continue!")
        sys.exit(1)
    token = "" if "--offline" in rest else "ex-code"
    egl = [
        "-AUTH_LOGIN=unused",
        f"-AUTH_PASSWORD={token}",
        "-AUTH_TYPE=exchangecode",
        f"-epicapp={rest[0]}",
        "-epicusername=Yas so",
        f"-epicovt={config}/tmp/ns.ovt",
    ]
    launch = {"game_parameters": ["-SaveToUserDir"], "game_executable": "x64/Hades.exe", "game_directory": "/g/Hades", "egl_parameters": egl}
    print(json.dumps({**launch, "launch_command": [], "working_directory": "/g/Hades/x64", "user_parameters": [], "environment": {}}))
elif verb == "sync-saves":
    # legendary 0.21.1's cli.sync_saves over a folder standing in for the cloud (SHIM_CLOUD): the newest mtime is each side's date.
    import shutil
    from datetime import UTC, datetime

    if not rest or rest[0].startswith("-"):
        err("shim: sync-saves without an app name syncs every installed game")
        sys.exit(3)
    if "--save-path" in rest and rest[0] in installed:
        installed[rest[0]]["save_path"] = rest[rest.index("--save-path") + 1]
        save()
    if mode == "hang" or (mode == "hangdown" and "--skip-download" not in rest):
        time.sleep(60)
    info = lambda message: print(f"[cli] INFO: {message}", file=sys.stderr)  # noqa: E731
    info("Got 1 remote save game(s)")
    if mode == "cloudless":
        sys.exit(0)
    local, cloud = Path(rest[rest.index("--save-path") + 1]), Path(os.environ["SHIM_CLOUD"])
    upload_only, download_only = "--skip-download" in rest, "--skip-upload" in rest
    force_up, force_down = "--force-upload" in rest, "--force-download" in rest
    info(f'Checking "Hades" ({rest[0]})')
    info(f'Overriding save path with "{local}"...')
    local.mkdir(parents=True, exist_ok=True)

    def latest(folder):
        return max((p.stat().st_mtime for p in folder.rglob("*") if p.is_file()), default=0) if folder.is_dir() else 0

    def date(stamp):
        return datetime.fromtimestamp(stamp, UTC).strftime("%Y-%m-%d %H:%M:%S") if stamp else "N/A"

    def replace(src, dest):
        shutil.rmtree(dest, ignore_errors=True)
        shutil.copytree(src, dest)

    mine, theirs = latest(local), latest(cloud)
    if not mine and not theirs:
        info("No cloud or local savegame found.")
        sys.exit(0)
    same = mine and theirs and abs(mine - theirs) < 60
    if same and not (force_up or force_down):
        info('Save game for "Hades" is up to date, skipping...')
        sys.exit(0)
    remote_newer = not same and (not mine or (theirs and theirs > mine))
    if (remote_newer and not force_up) or force_down:
        if remote_newer:
            info('Cloud save for "Hades" is newer:')
            info(f"- Cloud save date: {date(theirs)}")
            info(f"- Local save date: {date(mine)}")
        if upload_only:
            info("Save game downloading is disabled, skipping...")
            sys.exit(0)
        info("Downloading remote savegame...")
        replace(cloud, local)
    else:
        if not same:
            info('Local save for "Hades" is newer')
            info(f"- Cloud save date: {date(theirs)}")
            info(f"- Local save date: {date(mine)}")
        if download_only:
            info("Save game uploading is disabled, skipping...")
            sys.exit(0)
        info("Uploading local savegame...")
        replace(local, cloud)
elif verb == "achievements":
    if mode == "none":
        print("[cli] INFO: No achievements found", file=sys.stderr)
    else:
        groups = {
            "completed": [("a", "First", "d", True, False, "2024-05-01 20:11:04+00:00", "https://x/a.png", {"percent": 3.5})],
            "in_progress": [],
            "uninitiated": [("b", "Second", "", False, False, None, "https://x/b-locked.png", 12)],
            "hidden": [("c", "Hidden", "", False, True, None, "", None)],
        }
        keys = ("name", "display_name", "description", "unlocked", "hidden", "unlock_date", "icon_link", "rarity")
        print(json.dumps({group: [dict(zip(keys, row, strict=True)) for row in rows] for group, rows in groups.items()}))
else:
    err(f"shim: unexpected {args}")
    sys.exit(3)
