[Desktop Entry]
Type=Application
Name=Universe
Comment=The game launcher on the whole screen, like a console
Exec=universe-ui --session
# No TryExec: the greeter runs as its own user, and cannot see into the 0700 home install.sh puts universe-ui in
# Becomes XDG_CURRENT_DESKTOP: a name the core matches to no desktop of its own
DesktopNames=Universe
