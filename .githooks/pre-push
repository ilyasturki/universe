#!/usr/bin/env bash
# Wired by `just setup` (core.hooksPath = .githooks); UNIVERSE_SKIP_HOOKS=1 skips it for one push.
set -euo pipefail
[ "${UNIVERSE_SKIP_HOOKS:-}" = 1 ] && exit 0
cd "$(git rev-parse --show-toplevel)"
# A worktree's hook inherits an absolute GIT_DIR, which turns the tests' scratch repos into this one
mapfile -t repo_vars < <(git rev-parse --local-env-vars)
unset "${repo_vars[@]}"
just verify
