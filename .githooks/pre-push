#!/usr/bin/env bash
# Wired by `just setup` (core.hooksPath = .githooks); UNIVERSE_SKIP_HOOKS=1 skips it for one push.
set -euo pipefail
[ "${UNIVERSE_SKIP_HOOKS:-}" = 1 ] && exit 0
cd "$(git rev-parse --show-toplevel)"
# git hands the hook GIT_DIR, which would point the tests' own git calls at this repo
mapfile -t local_vars < <(git rev-parse --local-env-vars)
unset "${local_vars[@]}"
just verify
