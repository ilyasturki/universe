#!/usr/bin/env python3
import importlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _gamepads
import _mapping
from _controls import FACE, Context, Skip

WRITERS = (
    "eden",
    "ryujinx",
    "dolphin",
    "cemu",
    "azahar",
    "melonds",
    "mgba",
    "snes9x",
    "mupen64plus",
    "rpcs3",
    "pcsx2",
    "duckstation",
    "ppsspp",
    "xemu",
    "flycast",
    "scummvm",
)
# Emulators with nothing to write whose own SDL hints change which driver claims a pad, and with it its GUID.
HINTS = {"vita3k": {"SDL_JOYSTICK_ENHANCED_REPORTS": "1", "SDL_JOYSTICK_HIDAPI_SWITCH": "1", "SDL_JOYSTICK_HIDAPI_JOY_CONS": "1"}}
PROTON_RUNNERS = ("xenia",)
BACKUP_SUFFIX = ".before-universe"


def log(msg):
    print(msg, file=sys.stderr)


def _cli(*args):
    r = subprocess.run([os.environ.get("UNIVERSE_BIN") or "universe", *args], capture_output=True, text=True, check=False)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None


def pads_module_runs(game_id):
    """The pads module hides the physical pads from the emulator's SDL, so bindings written for them would read nothing."""
    entry = next((m for m in _cli("--json", "module", "ls") or [] if m.get("id") == "pads"), None)
    if not entry or not entry.get("enabled") or not entry.get("available"):
        return False
    if not os.access("/dev/uhid", os.R_OK | os.W_OK):
        return False
    settings = _cli("module", "settings", "pads", game_id)
    if settings is None:
        log(f"universe module settings pads {game_id} failed: taking the pads module as serving the game")
        return True
    return bool(settings.get("enabled", True))


def write(path: Path, text):
    """Through a symlink to its target, so a config kept in a dotfiles repository stays linked."""
    path = Path(os.path.realpath(path))
    if path.exists():
        if path.read_text() == text:
            return
        backup = path.with_name(path.name + BACKUP_SUFFIX)
        if not backup.exists():
            shutil.copy2(path, backup)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        if path.exists():
            shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def main():
    settings = json.loads(os.environ.get("MODULE_SETTINGS_JSON") or "{}")
    effective = json.loads(os.environ.get("UNIVERSE_GAME_JSON") or "{}").get("effective") or {}
    runner = effective.get("runner") or ""
    if effective.get("runner_kind") != "emulator":
        return 0
    if runner in PROTON_RUNNERS:
        log(f"{runner} runs through Proton, whose SDL reads the pads: controls left as they are")
        return 0
    if effective.get("inputplumber"):
        log("InputPlumber has this game's pads (its runner's inputplumber option is on): controls left as they are")
        return 0
    if pads_module_runs(os.environ.get("GAME_ID", "")):
        log("the pads module serves this game its virtual pads: controls left as they are")
        return 0

    writer = importlib.import_module(f"_{runner}") if runner in WRITERS else None
    for k, v in (effective.get("env") or {}).items():
        if k.startswith("SDL_"):
            os.environ[k] = v
    databases = writer.databases() if writer and hasattr(writer, "databases") else []
    hints = writer.hints() if writer and hasattr(writer, "hints") else HINTS.get(runner, {})
    try:
        pads = _gamepads.pads({**({"SDL_GAMECONTROLLERCONFIG_FILE": str(databases[-1])} if databases else {}), **hints})
    except OSError as e:
        log(f"SDL3 could not list the pads ({e}): controls left as they are")
        return 0
    if not pads:
        log("no pad held: controls left as they are")
        return 0
    ctx = Context(
        pads=pads,
        layout=settings.get("layout") if settings.get("layout") in FACE else "positional",
        guide=bool(settings.get("guide")),
        runner_path=effective.get("runner_path") or "",
        platform=effective.get("platform") or "",
    )

    mappings = _mapping.path(os.environ["SESSION_ID"])
    mappings.parent.mkdir(parents=True, exist_ok=True)
    mappings.write_text(_mapping.text(pads, ctx.guide, databases))
    with open(os.environ["UNIVERSE_ENV_FILE"], "a") as f:
        f.write(f"SDL_GAMECONTROLLERCONFIG_FILE={mappings}\n")

    if writer is None:
        log(f"{runner} has no controls to write: only HOME, capture and the paddles are taken from its pads")
    else:
        try:
            for path, text in writer.plan(ctx).items():
                write(Path(path), text)
        except Skip as e:
            log(str(e))
    for player, pad in enumerate(pads, 1):
        log(f"player {player}: {pad.name}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
