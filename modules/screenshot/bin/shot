#!/usr/bin/env python3
import contextlib
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time

EXTENSION_UUID = "universe@ilyasturki.github.io"
WINDOWS_BUS_NAME = "org.universe.Windows"
TAKE_TIMEOUT_S = 15


def log(msg):
    print(f"[screenshot] {msg}", file=sys.stderr, flush=True)


def bus_call_bool(call, timeout=None):
    """A session-bus call whose reply is one boolean; False on any failure."""
    try:
        r = subprocess.run(["busctl", "--user", "--json=short", "call", *call], capture_output=True, text=True, timeout=timeout, check=False)
        return r.returncode == 0 and json.loads(r.stdout)["data"] == [True]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        return False


def bus_name_has_owner(name):
    return bus_call_bool(["org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner", "s", name])


def extension_ready():
    if "GNOME" not in (os.environ.get("XDG_CURRENT_DESKTOP") or ""):
        return False
    dirs = [os.path.expanduser("~/.local/share"), *(os.environ.get("XDG_DATA_DIRS") or "/usr/share").split(":")]
    if not any(os.path.isdir(os.path.join(d, "gnome-shell/extensions", EXTENSION_UUID)) for d in dirs):
        log(f"{EXTENSION_UUID} not installed")
        return False
    if bus_name_has_owner(WINDOWS_BUS_NAME):
        return True
    if not bus_call_bool(["org.gnome.Shell.Extensions", "/org/gnome/Shell/Extensions", "org.gnome.Shell.Extensions", "EnableExtension", "s", EXTENSION_UUID]):
        log(f"{EXTENSION_UUID} installed but not loaded (log out once to load it)")
        return False
    # EnableExtension returns before enable() runs: the name lags the call.
    deadline = time.monotonic() + 3
    while not bus_name_has_owner(WINDOWS_BUS_NAME):
        if time.monotonic() > deadline:
            log(f"{EXTENSION_UUID} enabled but {WINDOWS_BUS_NAME} never came up")
            return False
        time.sleep(0.25)
    return True


def take_in_shell(path, window, cursor):
    """org.universe.Windows.Screenshot: answers once the pixels are grabbed, the PNG lands a moment later."""
    return bus_call_bool(
        [WINDOWS_BUS_NAME, "/org/universe/Windows", WINDOWS_BUS_NAME, "Screenshot", "sbb", path, "true" if window else "false", "true" if cursor else "false"],
        timeout=TAKE_TIMEOUT_S,
    )


def take_with_gsr(screen, path):
    # gsr leaves gsr-kms-server running (reparented): a stderr pipe would block on it, and killpg reaps it.
    with tempfile.TemporaryFile(mode="w+") as errf:
        proc = subprocess.Popen(["gpu-screen-recorder", "-w", screen, "-o", path], stdout=subprocess.DEVNULL, stderr=errf, start_new_session=True)
        try:
            proc.wait(timeout=TAKE_TIMEOUT_S)
        except subprocess.TimeoutExpired:
            log(f"gpu-screen-recorder -o {path} did not exit within {TAKE_TIMEOUT_S}s")
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGTERM)
        errf.seek(0)
        stderr = errf.read()
    if proc.returncode == 0 and os.path.exists(path) and os.path.getsize(path) > 0:
        return True
    log(f"gpu-screen-recorder -o {path} failed: {stderr.strip()}")
    return False


def main():
    settings = json.loads(os.environ.get("MODULE_SETTINGS_JSON") or "{}")
    directory = os.environ["SCREENSHOTS_DIR"]
    os.makedirs(directory, exist_ok=True)
    path = os.path.join(directory, time.strftime("%Y%m%d-%H%M%S") + ".png")

    if extension_ready():
        if take_in_shell(path, bool(settings.get("window", True)), bool(settings.get("cursor"))):
            print(path)
            return 0
        log(f"the shell refused {path} or did not answer")
    if not shutil.which("gpu-screen-recorder"):
        log("no shell grab and no gpu-screen-recorder to fall back on")
        return 1
    if not take_with_gsr(os.environ["SESSION_SCREEN"], path):
        return 1
    print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
