#!/usr/bin/env python3
import contextlib
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time

TAKE_TIMEOUT_S = 15


def log(msg):
    print(f"[screenshot] {msg}", file=sys.stderr, flush=True)


def take_with_universe(path, *args):
    cmd = [os.environ.get("UNIVERSE_BIN") or "universe", *args]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=TAKE_TIMEOUT_S, check=False)
    except (OSError, subprocess.SubprocessError) as e:
        log(f"universe {args[0]}: {e}")
        return False
    if r.returncode == 0 and os.path.exists(path) and os.path.getsize(path) > 0:
        return True
    log(f"universe {args[0]} {path} failed: {r.stderr.strip()}")
    return False


def take_in_gamescope(path, window):
    """gamescope's own shot of its screen, whatever the desktop around it: the game alone, else with the HUD over it."""
    return take_with_universe(path, "nest-shot", path, *([] if window else ["--overlays"]))


def take_on_desktop(path, screen, window, cursor):
    """The desktop's own grab, as desktop.profile picks it: the GNOME extension, spectacle, grim, the X server."""
    return take_with_universe(path, "desktop-shot", path, "--screen", screen, *(["--window"] if window else []), *(["--cursor"] if cursor else []))


def take_with_gsr(screen, path):
    # gsr leaves gsr-kms-server running (reparented): a stderr pipe would block on it, and killpg reaps it.
    with tempfile.TemporaryFile(mode="w+") as errf:
        proc = subprocess.Popen(["gpu-screen-recorder", "-w", screen, "-o", path], stdout=subprocess.DEVNULL, stderr=errf, start_new_session=True)
        try:
            proc.wait(timeout=TAKE_TIMEOUT_S)
        except subprocess.TimeoutExpired:
            log(f"gpu-screen-recorder -o {path} did not exit within {TAKE_TIMEOUT_S}s")
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGTERM)
        errf.seek(0)
        stderr = errf.read()
    if proc.returncode == 0 and os.path.exists(path) and os.path.getsize(path) > 0:
        return True
    log(f"gpu-screen-recorder -o {path} failed: {stderr.strip()}")
    return False


def main():
    settings = json.loads(os.environ.get("MODULE_SETTINGS_JSON") or "{}")
    directory = os.environ["SCREENSHOTS_DIR"]
    os.makedirs(directory, exist_ok=True)
    path = os.path.join(directory, time.strftime("%Y%m%d-%H%M%S") + ".png")
    screen = os.environ.get("SESSION_SCREEN") or ""

    window = bool(settings.get("window", True))
    if os.environ.get("GAMESCOPE_WAYLAND_DISPLAY"):
        taken = take_in_gamescope(path, window)
    else:
        taken = take_on_desktop(path, screen, window, bool(settings.get("cursor")))
    if taken:
        print(path)
        return 0
    if not shutil.which("gpu-screen-recorder"):
        log("the desktop took no shot and there is no gpu-screen-recorder to fall back on")
        return 1
    if not take_with_gsr(screen, path):
        return 1
    print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
