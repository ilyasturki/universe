#!/usr/bin/env python3
import json
import os
import sys
import time

TAKE_TIMEOUT_S = 15
GRABBED = "grabbed"


def log(msg):
    print(f"[screenshot] {msg}", file=sys.stderr, flush=True)


def take_in_gamescope(path, window):
    """gamescope's own shot, whatever the desktop: nest-shot takes this process's place, its `grabbed` and path go straight to the core."""
    exe = os.environ.get("UNIVERSE_BIN") or "universe"
    try:
        os.execvp(exe, [exe, "nest-shot", path, *([] if window else ["--overlays"])])
    except OSError as e:
        log(f"universe nest-shot: {e}")
    return 1


def take_on_desktop(path, screen, window, cursor):
    """(taken, grabbed) of the desktop's own grab, as desktop.profile picks it (the GNOME extension, spectacle, grim, the X server); its `grabbed` passed on as it comes."""
    import subprocess
    import threading

    exe = os.environ.get("UNIVERSE_BIN") or "universe"
    cmd = [exe, "desktop-shot", path, "--screen", screen, *(["--window"] if window else []), *(["--cursor"] if cursor else [])]
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    except OSError as e:
        log(f"universe desktop-shot: {e}")
        return False, False
    grabbed = False
    watchdog = threading.Timer(TAKE_TIMEOUT_S, proc.kill)
    watchdog.daemon = True
    watchdog.start()
    with proc:
        for line in proc.stdout or ():
            if line.strip() == GRABBED and not grabbed:
                grabbed = True
                print(GRABBED, flush=True)
    watchdog.cancel()
    if proc.returncode == 0 and os.path.exists(path) and os.path.getsize(path) > 0:
        return True, grabbed
    log(f"universe desktop-shot {path} failed (exit {proc.returncode})")
    return False, grabbed


def take_with_gsr(screen, path):
    import contextlib
    import signal
    import subprocess
    import tempfile

    # gsr leaves gsr-kms-server running (reparented): a stderr pipe would block on it, and killpg reaps it.
    with tempfile.TemporaryFile(mode="w+") as errf:
        proc = subprocess.Popen(["gpu-screen-recorder", "-w", screen, "-o", path], stdout=subprocess.DEVNULL, stderr=errf, start_new_session=True)
        try:
            proc.wait(timeout=TAKE_TIMEOUT_S)
        except subprocess.TimeoutExpired:
            log(f"gpu-screen-recorder -o {path} did not exit within {TAKE_TIMEOUT_S}s")
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGTERM)
        errf.seek(0)
        stderr = errf.read()
    if proc.returncode == 0 and os.path.exists(path) and os.path.getsize(path) > 0:
        return True
    log(f"gpu-screen-recorder -o {path} failed: {stderr.strip()}")
    return False


def main():
    settings = json.loads(os.environ.get("MODULE_SETTINGS_JSON") or "{}")
    directory = os.environ["SCREENSHOTS_DIR"]
    os.makedirs(directory, exist_ok=True)
    path = os.path.join(directory, time.strftime("%Y%m%d-%H%M%S") + ".png")
    screen = os.environ.get("SESSION_SCREEN") or ""

    window = bool(settings.get("window", True))
    # No fallback once a grab is told: a capture after its `grabbed` would be another moment than the shutter's.
    if os.environ.get("GAMESCOPE_WAYLAND_DISPLAY"):
        return take_in_gamescope(path, window)
    taken, grabbed = take_on_desktop(path, screen, window, bool(settings.get("cursor")))
    if taken:
        print(path)
        return 0
    if grabbed:
        return 1
    import shutil

    if not shutil.which("gpu-screen-recorder"):
        log("the desktop took no shot and there is no gpu-screen-recorder to fall back on")
        return 1
    if not take_with_gsr(screen, path):
        return 1
    print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
