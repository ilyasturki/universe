#!/usr/bin/env python3
"""Helper (not a hook): reports whether a capture unit is running."""
import subprocess
import sys


def is_active(unit):
    result = subprocess.run(["systemctl", "--user", "is-active", unit], capture_output=True, text=True)
    return result.stdout.strip()


def main():
    if len(sys.argv) > 1:
        unit = f"universe-capture-{sys.argv[1]}.service"
        state = is_active(unit)
        print(f"{unit}: {state}")
        return 0 if state == "active" else 1

    result = subprocess.run(
        ["systemctl", "--user", "list-units", "universe-capture-*.service", "--no-legend", "--plain"],
        capture_output=True, text=True,
    )
    lines = [l for l in result.stdout.splitlines() if l.strip()]
    if not lines:
        print("no capture unit running")
        return 1
    for line in lines:
        print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
