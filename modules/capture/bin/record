#!/usr/bin/env python3
"""The capture unit's main process: gpu-screen-recorder as a child, moved to the monitor that replaces the one it records."""

import os
import signal
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import flag_value
from _record import Recorder


def main(argv):
    gsr = argv[argv.index("--") + 1 :] if "--" in argv else argv
    if flag_value(gsr, "-w") == "portal" or not flag_value(gsr, "-o"):
        os.execvp(gsr[0], gsr)
    recorder = Recorder(gsr, os.environ["SESSION_ID"], os.environ["MODULE_DATA_DIR"], os.environ["SESSION_UNIT"])
    # systemd stops the whole cgroup: the recorder got the signal too and saves on its own.
    signal.signal(signal.SIGTERM, lambda *_: setattr(recorder, "stopping", True))
    return recorder.run()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
