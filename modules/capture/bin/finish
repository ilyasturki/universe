#!/usr/bin/env python3
"""Files the session's recording: the parts a monitor switch left, stitched into one, then the usual checks and `universe recording-file`."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import load_settings
from _finish import finish


def main(argv):
    return finish(os.environ["SESSION_ID"], os.environ["MODULE_DATA_DIR"], argv[0] if argv else None, load_settings().get("min_duration_s", 240))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
