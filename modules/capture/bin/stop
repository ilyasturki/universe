#!/usr/bin/env python3
import glob
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import gsr_cli, load_settings, log, timeline, unit_env_args
from _finish import finish

BIN_DIR = os.path.dirname(os.path.abspath(__file__))


def stop_unit(unit):
    result = subprocess.run(["systemctl", "--user", "stop", unit], capture_output=True, text=True)
    if result.returncode != 0 and "not loaded" not in result.stderr.lower():
        log(f"systemctl stop {unit} failed: {result.stderr.strip()}")


# The hook has timeout_s = 20 in all: the recorder's save, else the unit's stop (TimeoutStopSec=10), then ffprobe.
STOP_WAIT_S = 8
# What is left of the 20 s for a stitch; past it the unit finishes alone and the journal's post-process runs without the recording.
STITCH_WAIT_S = 9


def stop_recorder(session_id, pending_dir):
    """The saved file's path, from the recorder once it has written it; the unit's stop and a glob when the socket is already gone."""
    try:
        r = gsr_cli(session_id, "stop", timeout=STOP_WAIT_S)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
        log(f"gsr-cli stop: {(r.stderr or r.stdout).strip() or 'no path'}")
    except (OSError, subprocess.SubprocessError) as e:
        log(f"gsr-cli stop: {e}")
    stop_unit(f"universe-capture-{session_id}.service")
    return next(iter(glob.glob(os.path.join(pending_dir, f"{session_id}.mkv")) + glob.glob(os.path.join(pending_dir, f"{session_id}.mp4"))), None)


def finish_in_unit(session_id, current):
    """A stitch copies every byte of the session: its own unit, waited for as long as the hook can."""
    cmd = ["systemd-run", "--user", f"--unit=universe-capture-finish-{session_id}", "--collect", "--wait", "--quiet", *unit_env_args(), os.path.join(BIN_DIR, "finish"), *([current] if current else [])]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=STITCH_WAIT_S, check=False)
    except subprocess.TimeoutExpired:
        log(f"stitching goes on in universe-capture-finish-{session_id}; the journal will not have this recording's frames")
        return 0
    if r.returncode != 0:
        log(f"finish unit: {r.stderr.strip()}")
    return r.returncode


def main():
    session_id = os.environ["SESSION_ID"]
    data_dir = os.environ["MODULE_DATA_DIR"]
    pending_dir = os.path.join(data_dir, "pending")

    with timeline(data_dir, session_id) as state:
        if state is not None:
            state["stopping"] = True
        parts = list((state or {}).get("parts") or [])
    current = stop_recorder(session_id, pending_dir)
    if parts:
        return finish_in_unit(session_id, current)
    return finish(session_id, data_dir, current, load_settings().get("min_duration_s", 240))


if __name__ == "__main__":
    sys.exit(main())
