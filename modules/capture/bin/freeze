#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import set_paused, timeline  # noqa: E402


def main():
    session_id = os.environ["SESSION_ID"]
    # No timeline yet: the recorder is not up, and `start` reads the game's freezer state once it is.
    with timeline(os.environ["MODULE_DATA_DIR"], session_id) as state:
        if state is not None:
            set_paused(state, session_id, True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
