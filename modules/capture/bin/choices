#!/usr/bin/env python3
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import screen_refresh_hz

RATES = ["120", "90", "60", "30"]


def main(argv):
    if argv[:1] != ["fps"]:
        return 2
    hz = screen_refresh_hz(os.environ.get("SESSION_SCREEN", ""))
    # Recording above the screen's rate captures nothing more; 30 always stays offered.
    print(json.dumps(["auto"] + [r for r in RATES if hz is None or int(r) <= max(hz, 30)]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
