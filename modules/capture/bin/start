#!/usr/bin/env python3
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import (
    cli_json,
    extension_ready,
    game_frozen,
    gsr_args,
    load_settings,
    log,
    set_paused,
    show_osd,
    timeline,
    unit_active,
    unit_env_args,
    wait_recorder,
)

RECORD = os.path.join(os.path.dirname(os.path.abspath(__file__)), "record")


def window_token(settings, data_dir):
    if not extension_ready():
        return None
    wait_s = max(0, int(settings.get("window_wait_s", 60)))
    # The CLI opens the core and asks the shell before its own wait starts.
    if not cli_json(["session-window", "--wait", str(wait_s)], timeout=wait_s + 30):
        log(f"no game window within {wait_s}s")
        return None
    tokens = os.path.join(data_dir, "portal")
    os.makedirs(tokens, exist_ok=True)
    return os.path.join(tokens, os.environ["GAME_ID"])


def main():
    settings = load_settings()
    if not settings.get("enabled", True):
        log("disabled for this game, not recording")
        return 0

    session_id = os.environ["SESSION_ID"]
    data_dir = os.environ["MODULE_DATA_DIR"]
    pending_dir = os.path.join(data_dir, "pending")
    os.makedirs(pending_dir, exist_ok=True)
    output = os.path.join(pending_dir, f"{session_id}.{settings.get('container') or 'mkv'}")

    token = None
    if settings.get("source") == "window":
        token = window_token(settings, data_dir)
        if not token:
            log("recording the screen")
            show_osd("Recording the screen")

    game_unit = os.environ["SESSION_UNIT"]
    cmd = [
        "systemd-run",
        "--user",
        f"--unit=universe-capture-{session_id}",
        "--collect",
        "-p",
        "CPUWeight=100",
        "-p",
        "MemoryHigh=4G",
        "-p",
        f"BindsTo={game_unit}",
        "-p",
        f"After={game_unit}",
        # systemd's 90s default TimeoutStopSec would blow session-end's timeout_s=20 if gsr hangs.
        "-p",
        "TimeoutStopSec=10",
        *unit_env_args(),
        RECORD,
        "--",
        *gsr_args(settings, os.environ["SESSION_SCREEN"], output, token, session_id),
    ]
    log(" ".join(cmd))
    # Ahead of the recorder: it reads a missing timeline as a session already stopping and dies without a word.
    with timeline(data_dir, session_id, create=True):
        pass
    result = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        log(f"systemd-run failed ({result.returncode}): {result.stderr.strip()}")
        return 1
    unit = f"universe-capture-{session_id}.service"
    if not wait_recorder(session_id, alive=lambda: unit_active(unit)):
        if not unit_active(unit):
            log(f"the recorder is already gone; this session is not being recorded (journalctl --user -u {unit})")
            show_osd("Recording failed", "dialog-warning-symbolic")
            return 1
        log("the recorder's socket did not come up; pauses may be missed")
    with timeline(data_dir, session_id) as state:
        if state is not None and game_frozen(game_unit):
            set_paused(state, session_id, True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
