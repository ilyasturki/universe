#!/usr/bin/env python3
"""post-launch hook (async): starts the window recorder (bin/record-window) or gpu-screen-recorder under a transient unit."""
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import (  # noqa: E402
    EXTENSION_UUID, WINDOWS_BUS_NAME, log, load_settings, resolve_screen, gsr_args, output_path,
    is_gnome, extension_installed, enable_extension, bus_name_has_owner, write_companion, show_osd,
)


def bind_args():
    game_unit = os.environ.get("SESSION_UNIT")
    if not game_unit:
        return []
    return ["-p", f"BindsTo={game_unit}", "-p", f"After={game_unit}"]


def run_systemd(cmd):
    log(" ".join(cmd))
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        log(f"systemd-run failed ({result.returncode}): {result.stderr.strip()}")
        return False
    return True


def start_window(unit, pending_dir, session_id):
    record_window = os.path.join(os.path.dirname(os.path.abspath(__file__)), "record-window")
    passthrough = ["SESSION_ID", "SESSION_UNIT", "SESSION_SCREEN", "MODULE_SETTINGS_JSON",
                   "MODULE_DATA_DIR", "PATH", "GST_PLUGIN_SYSTEM_PATH_1_0"]
    env_args = []
    for key in passthrough:
        val = os.environ.get(key)
        if val is not None:
            env_args += ["-E", f"{key}={val}"]
    cmd = [
        "systemd-run", "--user", f"--unit={unit}", "--collect",
        "-p", "CPUWeight=100", "-p", "MemoryHigh=4G",
        *bind_args(),
        "-p", "TimeoutStopSec=10",
        # gst-launch -e finalises on SIGINT, and only one may reach it: record-window forwards it (KillMode=mixed).
        "-p", "KillMode=mixed", "-p", "KillSignal=SIGINT",
        *env_args,
        record_window,
    ]
    return run_systemd(cmd)


def start_screen(unit, screen, settings, path):
    cmd = [
        "systemd-run", "--user", f"--unit={unit}", "--collect",
        "-p", "CPUWeight=100", "-p", "MemoryHigh=4G",
        *bind_args(),
        # bounds `systemctl stop`'s wait below bin/stop's own 15s stability budget;
        # default TimeoutStopSec (90s) would blow session-end's timeout_s=20 if gsr hangs.
        "-p", "TimeoutStopSec=10",
        *gsr_args(settings, screen, path),
    ]
    return run_systemd(cmd)


def main():
    settings = load_settings()
    if not settings.get("enabled", True):
        log("disabled for this game, not recording")
        return 0

    session_id = os.environ["SESSION_ID"]
    data_dir = os.environ["MODULE_DATA_DIR"]
    pending_dir = os.path.join(data_dir, "pending")
    os.makedirs(pending_dir, exist_ok=True)

    try:
        screen = resolve_screen()
    except Exception as e:
        log(f"could not resolve a screen to capture: {e}")
        return 1

    unit = f"universe-capture-{session_id}"
    path = output_path(pending_dir, session_id, settings)
    source = settings.get("source", "window")

    if source == "window" and is_gnome():
        if extension_installed():
            enable_extension()
            # EnableExtension runs the extension's enable() asynchronously in the shell,
            # so the well-known name can lag the call by a moment on the first launch.
            deadline = time.monotonic() + 3
            owned = bus_name_has_owner(WINDOWS_BUS_NAME)
            while not owned and time.monotonic() < deadline:
                time.sleep(0.25)
                owned = bus_name_has_owner(WINDOWS_BUS_NAME)
            if owned:
                if not start_window(unit, pending_dir, session_id):
                    return 1
                write_companion(pending_dir, session_id, unit, path, "window")
                return 0
            log(f"{EXTENSION_UUID} installed but not loaded (log out once to load it); recording the screen")
        else:
            log(f"{EXTENSION_UUID} not installed; recording the screen")

    if not start_screen(unit, screen, settings, path):
        return 1
    write_companion(pending_dir, session_id, unit, path, "screen")
    if source == "window":
        show_osd("Recording the screen")
    return 0


if __name__ == "__main__":
    sys.exit(main())
