#!/usr/bin/env python3
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import (  # noqa: E402
    log, load_settings, resolve_screen, gsr_args, output_path, extension_ready, unit_cgroup, wait_for_window, show_osd,
)


def window_token(settings, data_dir):
    if not extension_ready():
        return None
    wait_s = max(0, int(settings.get("window_wait_s", 60)))
    if not wait_for_window(unit_cgroup(os.environ.get("SESSION_UNIT")), wait_s):
        log(f"no game window within {wait_s}s")
        return None
    tokens = os.path.join(data_dir, "portal")
    os.makedirs(tokens, exist_ok=True)
    return os.path.join(tokens, os.environ["GAME_ID"])


def main():
    settings = load_settings()
    if not settings.get("enabled", True):
        log("disabled for this game, not recording")
        return 0

    session_id = os.environ["SESSION_ID"]
    data_dir = os.environ["MODULE_DATA_DIR"]
    pending_dir = os.path.join(data_dir, "pending")
    os.makedirs(pending_dir, exist_ok=True)
    screen = resolve_screen()

    token = window_token(settings, data_dir) if settings.get("source") == "window" else None
    if settings.get("source") == "window" and not token:
        log("recording the screen")
        show_osd("Recording the screen")

    game_unit = os.environ["SESSION_UNIT"]
    cmd = [
        "systemd-run", "--user", f"--unit=universe-capture-{session_id}", "--collect",
        "-p", "CPUWeight=100", "-p", "MemoryHigh=4G",
        "-p", f"BindsTo={game_unit}", "-p", f"After={game_unit}",
        # systemd's 90s default TimeoutStopSec would blow session-end's timeout_s=20 if gsr hangs.
        "-p", "TimeoutStopSec=10",
        *gsr_args(settings, screen, output_path(pending_dir, session_id, settings), token),
    ]
    log(" ".join(cmd))
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        log(f"systemd-run failed ({result.returncode}): {result.stderr.strip()}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
