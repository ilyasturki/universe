#!/usr/bin/env python3
"""post-launch hook (async): starts gpu-screen-recorder under a transient unit — the screen, or the game's
window through the GNOME picker once the window is up (the pick is remembered per game)."""
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import (  # noqa: E402
    log, load_settings, resolve_screen, gsr_args, output_path, extension_ready, unit_cgroup,
    wait_for_window, window_wait_s, write_companion, show_osd,
)


def bind_args():
    game_unit = os.environ.get("SESSION_UNIT")
    if not game_unit:
        return []
    return ["-p", f"BindsTo={game_unit}", "-p", f"After={game_unit}"]


def run_systemd(cmd):
    log(" ".join(cmd))
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        log(f"systemd-run failed ({result.returncode}): {result.stderr.strip()}")
        return False
    return True


def window_token(settings, data_dir):
    """The portal token file for the game's window, once it is up; None when the screen is recorded instead."""
    if not extension_ready():
        return None
    wait_s = window_wait_s(settings)
    if not wait_for_window(unit_cgroup(os.environ.get("SESSION_UNIT")), wait_s):
        log(f"no game window within {wait_s}s")
        return None
    tokens = os.path.join(data_dir, "portal")
    os.makedirs(tokens, exist_ok=True)
    return os.path.join(tokens, os.environ["GAME_ID"])


def main():
    settings = load_settings()
    if not settings.get("enabled", True):
        log("disabled for this game, not recording")
        return 0

    session_id = os.environ["SESSION_ID"]
    data_dir = os.environ["MODULE_DATA_DIR"]
    pending_dir = os.path.join(data_dir, "pending")
    os.makedirs(pending_dir, exist_ok=True)

    try:
        screen = resolve_screen()
    except Exception as e:
        log(f"could not resolve a screen to capture: {e}")
        return 1

    token = window_token(settings, data_dir) if settings.get("source") == "window" else None
    if settings.get("source") == "window" and not token:
        log("recording the screen")
        show_osd("Recording the screen")

    unit = f"universe-capture-{session_id}"
    path = output_path(pending_dir, session_id, settings)
    cmd = [
        "systemd-run", "--user", f"--unit={unit}", "--collect",
        "-p", "CPUWeight=100", "-p", "MemoryHigh=4G",
        *bind_args(),
        # bounds `systemctl stop`'s wait below bin/stop's own 15s stability budget;
        # default TimeoutStopSec (90s) would blow session-end's timeout_s=20 if gsr hangs.
        "-p", "TimeoutStopSec=10",
        *gsr_args(settings, screen, path, token),
    ]
    if not run_systemd(cmd):
        return 1
    write_companion(pending_dir, session_id, unit, path, "window" if token else "screen")
    return 0


if __name__ == "__main__":
    sys.exit(main())
