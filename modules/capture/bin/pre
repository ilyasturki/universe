#!/usr/bin/env python3
"""Mutter's window screencast records a buffer gamescope scans out straight as one flat colour."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import load_settings  # noqa: E402


def main():
    settings = load_settings()
    if settings.get("enabled", True) and settings.get("source") == "window":
        with open(os.environ["UNIVERSE_ENV_FILE"], "a") as f:
            f.write("UNIVERSE_GAMESCOPE_ARGS=--force-composition\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
