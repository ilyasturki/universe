#!/usr/bin/env python3
import os
import signal
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import WINDOWS_BUS_NAME, bus_call_bool, extension_ready, load_settings, log, timeline

TAKE_TIMEOUT_S = 15


def take_in_shell(path, window, cursor):
    """org.universe.Windows.Screenshot: answers once the pixels are grabbed, the PNG lands a moment later."""
    ok = bus_call_bool([WINDOWS_BUS_NAME, "/org/universe/Windows", WINDOWS_BUS_NAME, "Screenshot", "sbb", path, "true" if window else "false", "true" if cursor else "false"], timeout=TAKE_TIMEOUT_S)
    return ok, "" if ok else "gnome-shell refused or did not answer"


def take(screen, path):
    # gsr leaves gsr-kms-server running (reparented): a stderr pipe would block on it, and killpg reaps it.
    with tempfile.TemporaryFile(mode="w+") as errf:
        proc = subprocess.Popen(
            ["gpu-screen-recorder", "-w", screen, "-o", path],
            stdout=subprocess.DEVNULL, stderr=errf, start_new_session=True,
        )
        try:
            proc.wait(timeout=TAKE_TIMEOUT_S)
        except subprocess.TimeoutExpired:
            log(f"gpu-screen-recorder -o {path} did not exit within {TAKE_TIMEOUT_S}s")
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        errf.seek(0)
        stderr = errf.read()
    ok = proc.returncode == 0 and os.path.exists(path) and os.path.getsize(path) > 0
    return ok, stderr


def session_screen():
    """The connector the recorder moved to, else the session's."""
    if os.environ.get("SESSION_ID"):
        with timeline(os.environ["MODULE_DATA_DIR"], os.environ["SESSION_ID"]) as state:
            if state is not None and state.get("screen"):
                return state["screen"]
    return os.environ["SESSION_SCREEN"]


def main():
    settings = load_settings()
    directory = os.environ["SCREENSHOTS_DIR"]
    os.makedirs(directory, exist_ok=True)
    path = os.path.join(directory, time.strftime("%Y%m%d-%H%M%S") + ".png")

    if extension_ready():
        ok, stderr = take_in_shell(path, settings.get("source", "screen") == "window", bool(settings.get("cursor")))
        if ok:
            print(path)
            return 0
        log(f"shell screenshot {path} failed: {stderr.strip()}")

    ok, stderr = take(session_screen(), path)
    if not ok:
        log(f"gpu-screen-recorder -o {path} failed: {stderr.strip()}")
        return 1
    print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
