#!/usr/bin/env python3
"""session-end hook (blocking, fast): tops up Hours and the Journal link in the
plain-Markdown games tracker. Never lowers Hours, never touches the Vibes/Rating
cells, never rewrites a line it didn't change. `--all` is the manual bulk path:
reads games/*/game.toml + sessions.jsonl directly, no D-Bus.
"""
import json
import os
import re
import sys
import unicodedata
from pathlib import Path

SETTINGS_DEFAULTS = {
    "root": "~/Documents/notes/games",
    "create_missing": False,
    "update_metadata": True,
    "journal_link": True,
}

# Order mirrors the README; wishlist.md is a bullet list (no Hours/Journal columns).
TABLES = ["playing", "hold", "backlog", "played", "dropped"]


def log(msg):
    print(f"[tracker-md] {msg}", file=sys.stderr, flush=True)


def load_settings():
    raw = os.environ.get("MODULE_SETTINGS_JSON", "") or "{}"
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError as e:
        log(f"MODULE_SETTINGS_JSON invalid ({e}), using defaults")
        parsed = {}
    settings = dict(SETTINGS_DEFAULTS)
    settings.update({k: v for k, v in parsed.items() if v is not None})
    settings["root"] = os.path.expanduser(str(settings["root"]))
    return settings


# ---------------------------------------------------------------------------
# Slug — mirrors sanitizeGameName, ~/NixOs/bin/lib/game-session.mjs:121.
# Divergence here silently orphans journal links, so every step matches the JS.
# ---------------------------------------------------------------------------

_COMBINING_RE = re.compile(r"[\u0300-\u036f]")
_APOSTROPHE_RE = re.compile(r"['’]")
_NON_SLUG_RE = re.compile(r"[^a-z0-9-]")
_DASH_RUN_RE = re.compile(r"-+")


def slugify(name):
    if not name:
        return "unknown"
    s = unicodedata.normalize("NFKD", str(name).lower())
    s = _COMBINING_RE.sub("", s)
    s = _APOSTROPHE_RE.sub("", s)
    s = _NON_SLUG_RE.sub("-", s)
    s = _DASH_RUN_RE.sub("-", s)
    return s.strip("-") or "unknown"


# ---------------------------------------------------------------------------
# Table I/O — a line-level patcher, not a reformatter: only the matched row's
# line changes, re-padded to the widths the file already uses (read off the
# separator line, the same numbers _lib.py's render() wrote them with).
# ---------------------------------------------------------------------------

def table_path(root, status):
    return os.path.join(root, f"{status}.md")


def split_row(line):
    return [c.strip() for c in line.strip().strip("|").split("|")]


def is_separator(line):
    s = line.strip()
    return s.startswith("|") and bool(s) and set(s) <= set("|-: ")


def parse_widths(sep_line):
    """Per-column width (all but the unpadded last column)."""
    segments = sep_line.strip().strip("|").split("|")
    return [len(seg) - 2 for seg in segments[:-1]]


def render(cells, widths):
    head = " | ".join(c.ljust(w) for c, w in zip(cells[:-1], widths))
    return f"| {head} | {cells[-1]} |"


def atomic_write(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def find_header(lines):
    """(header_idx, cols, widths) or None."""
    for i, line in enumerate(lines):
        if not line.strip().startswith("|"):
            continue
        if i + 1 >= len(lines) or not is_separator(lines[i + 1]):
            continue
        cols = split_row(line)
        widths = parse_widths(lines[i + 1])
        if len(widths) != len(cols) - 1:
            continue
        return i, cols, widths
    return None


def journal_cell_for(game_id, journal_root):
    if os.path.isdir(os.path.join(journal_root, game_id)):
        return f"[↗](journal/{game_id}/)"
    if os.path.isdir(os.path.join(journal_root, ".archive", game_id)):
        return f"[↗](journal/.archive/{game_id}/)"
    return None


def compute_hours_cell(existing_cell, computed):
    """max(existing, computed), one decimal; None when there's nothing to top up."""
    existing = float(existing_cell) if existing_cell else None
    if computed is None or computed <= 0:
        return None
    new_val = max(existing, computed) if existing is not None else computed
    formatted = f"{new_val:.1f}"
    return None if formatted == existing_cell else formatted


def find_and_update_row(root, title, game_id, computed_hours, settings):
    """Locate the row across the five tables and rewrite only its changed cells.

    Returns {"status", "changed", "row"} or None if no table has a matching row.
    """
    journal_root = os.environ.get("UNIVERSE_JOURNAL_ROOT") or os.path.join(root, "journal")

    for status in TABLES:
        path = table_path(root, status)
        if not os.path.isfile(path):
            continue
        text = Path(path).read_text(encoding="utf-8")
        lines = text.split("\n")

        header = find_header(lines)
        if header is None:
            continue
        header_idx, cols, widths = header
        game_idx = cols.index("Game")
        hours_idx = cols.index("Hours") if "Hours" in cols else None
        journal_idx = cols.index("Journal") if "Journal" in cols else None

        for i in range(header_idx + 2, len(lines)):
            line = lines[i]
            if not line.strip().startswith("|"):
                continue
            cells = split_row(line)
            if len(cells) != len(cols):
                continue
            game_cell = cells[game_idx]
            if game_cell.lower() != title.lower() and slugify(game_cell) != game_id:
                continue

            changed = False
            if hours_idx is not None:
                new_hours = compute_hours_cell(cells[hours_idx], computed_hours)
                if new_hours is not None:
                    cells[hours_idx] = new_hours
                    changed = True
            if journal_idx is not None and settings["journal_link"] and not cells[journal_idx]:
                link = journal_cell_for(game_id, journal_root)
                if link:
                    cells[journal_idx] = link
                    changed = True

            if changed:
                lines[i] = render(cells, widths)
                atomic_write(path, "\n".join(lines))
            return {"status": status, "changed": changed, "row": game_cell}

    return None


def append_missing_row(root, title, game_id, computed_hours, settings):
    """create_missing: append a row to playing.md, alphabetically (the tables' own convention)."""
    status = "playing"
    path = table_path(root, status)
    if not os.path.isfile(path):
        log(f"cannot create row, {path} missing")
        return False
    text = Path(path).read_text(encoding="utf-8")
    lines = text.split("\n")

    header = find_header(lines)
    if header is None:
        log(f"cannot parse {path}, skipping create")
        return False
    header_idx, cols, widths = header
    game_idx, hours_idx, journal_idx = cols.index("Game"), cols.index("Hours"), cols.index("Journal")

    new_cells = [""] * len(cols)
    new_cells[game_idx] = title
    if computed_hours and computed_hours > 0:
        new_cells[hours_idx] = f"{computed_hours:.1f}"
    if settings["journal_link"]:
        journal_root = os.environ.get("UNIVERSE_JOURNAL_ROOT") or os.path.join(root, "journal")
        new_cells[journal_idx] = journal_cell_for(game_id, journal_root) or ""
    new_line = render(new_cells, widths)

    i = header_idx + 2
    insert_at = None
    while i < len(lines) and lines[i].strip().startswith("|"):
        if split_row(lines[i])[game_idx].lower() > title.lower():
            insert_at = i
            break
        i += 1
    if insert_at is None:
        insert_at = i

    lines.insert(insert_at, new_line)
    atomic_write(path, "\n".join(lines))
    return True


# ---------------------------------------------------------------------------
# .data/games.json — fills blanks only, never touches an entry that isn't there
# already (tracker-md doesn't mint new sidecar records, only add_game.py does).
# ---------------------------------------------------------------------------

def is_blank(v):
    if v is None:
        return True
    if isinstance(v, str):
        return not v.strip()
    if isinstance(v, list):
        return not v
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return v == 0  # rawg_id/metacritic/etc. use 0 as the Rust-side "unset" sentinel
    return False


def extract_metadata_fields(game_json):
    meta = game_json.get("metadata") or {}
    developers = meta.get("developers") or []
    publishers = meta.get("publishers") or []
    genres = meta.get("genres") or []
    fields = {
        "developer": ", ".join(developers) if developers else None,
        "publisher": ", ".join(publishers) if publishers else None,
        "genre": list(genres) if genres else None,
        "release_year": game_json.get("release_year") or None,
        "summary": meta.get("summary") or None,
        "metacritic": meta.get("metacritic") or None,
        "rawg_id": meta.get("rawg_id") or None,
        "sgdb_id": meta.get("sgdb_id") or None,
        "steam_appid": meta.get("steam_appid") or None,
    }
    return {k: v for k, v in fields.items() if not is_blank(v)}


def update_metadata_sidecar(root, slug, game_json):
    meta_path = os.path.join(root, ".data", "games.json")
    if not os.path.isfile(meta_path):
        return
    try:
        data = json.loads(Path(meta_path).read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        log(f"games.json unreadable ({e}), skipping metadata")
        return
    entry = data.get(slug)
    if entry is None:
        return

    filled = []
    for k, v in extract_metadata_fields(game_json).items():
        if is_blank(entry.get(k)):
            entry[k] = v
            filled.append(k)
    if not filled:
        return

    payload = json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True) + "\n"
    atomic_write(meta_path, payload)
    log(f"{slug}: filled games.json field(s) {filled}")


# ---------------------------------------------------------------------------
# Per-game sync — shared by the hook (one game) and --all (every game).
# ---------------------------------------------------------------------------

def sync_one(game_id, title, game_json, settings, root):
    stats = game_json.get("stats") or {}
    try:
        computed_hours = float(stats.get("hours")) if stats.get("hours") is not None else 0.0
    except (TypeError, ValueError):
        computed_hours = 0.0

    result = find_and_update_row(root, title, game_id, computed_hours, settings)

    if result is None:
        if settings["create_missing"]:
            if append_missing_row(root, title, game_id, computed_hours, settings):
                log(f"{title}: no row found, added to playing.md")
        else:
            log(f"{title}: no row in any table, create_missing is false, nothing to do")
    elif result["changed"]:
        log(f"{title}: updated ({result['status']}.md)")
    else:
        log(f"{title}: unchanged")

    if settings["update_metadata"]:
        update_metadata_sidecar(root, game_id, game_json)

    return result


def main_hook():
    settings = load_settings()
    game_id = (os.environ.get("GAME_ID") or "").strip()
    if not game_id:
        log("GAME_ID missing, nothing to do")
        return 0

    raw = os.environ.get("UNIVERSE_GAME_JSON", "") or "{}"
    try:
        game_json = json.loads(raw)
    except json.JSONDecodeError as e:
        log(f"UNIVERSE_GAME_JSON invalid ({e}), nothing to do")
        return 0

    title = (os.environ.get("GAME_TITLE") or "").strip() or game_json.get("title") or game_id

    root = settings["root"]
    if not os.path.isdir(root):
        log(f"tracker root {root} not found, nothing to do")
        return 0

    try:
        sync_one(game_id, title, game_json, settings, root)
    except Exception as e:  # session-end must never fail the session
        log(f"unexpected error: {e}")
    return 0


def sum_session_hours(sessions_path):
    if not os.path.isfile(sessions_path):
        return 0.0
    total_s = 0.0
    with open(sessions_path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue
            try:
                total_s += float(rec.get("duration_s") or 0)
            except (TypeError, ValueError):
                pass
    return total_s / 3600.0


def main_all():
    import tomllib

    settings = load_settings()
    root = settings["root"]
    if not os.path.isdir(root):
        log(f"tracker root {root} not found")
        return 0

    data_home = os.environ.get("UNIVERSE_DATA_HOME") or os.path.expanduser("~/.local/share/universe")
    games_dir = os.path.join(data_home, "games")
    if not os.path.isdir(games_dir):
        log(f"no games under {games_dir}")
        return 0

    count = 0
    for entry in sorted(os.listdir(games_dir)):
        game_dir = os.path.join(games_dir, entry)
        toml_path = os.path.join(game_dir, "game.toml")
        if not os.path.isfile(toml_path):
            continue
        try:
            with open(toml_path, "rb") as f:
                game_toml = tomllib.load(f)
        except (OSError, tomllib.TOMLDecodeError) as e:
            log(f"{entry}: unreadable game.toml ({e}), skipping")
            continue
        if game_toml.get("removed_at"):
            continue

        game_id = game_toml.get("id") or entry
        title = game_toml.get("title") or game_id
        game_json = {
            "title": title,
            "release_year": game_toml.get("release_year"),
            "metadata": game_toml.get("metadata") or {},
            "stats": {"hours": sum_session_hours(os.path.join(game_dir, "sessions.jsonl"))},
        }
        try:
            sync_one(game_id, title, game_json, settings, root)
        except Exception as e:
            log(f"{game_id}: unexpected error: {e}")
        count += 1

    log(f"--all: processed {count} game(s)")
    return 0


def main():
    return main_all() if "--all" in sys.argv[1:] else main_hook()


if __name__ == "__main__":
    sys.exit(main())
