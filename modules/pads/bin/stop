#!/usr/bin/env python3
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _pads import log, unit_name


def main():
    unit = unit_name(os.environ["SESSION_ID"])
    r = subprocess.run(["systemctl", "--user", "stop", unit], capture_output=True, text=True, check=False)
    if r.returncode != 0 and "not loaded" not in r.stderr.lower():
        log(f"systemctl stop {unit}: {r.stderr.strip()}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
