#!/usr/bin/env python3
"""Frozen, the emulator reads nothing, and the kernel queues what the pads send for when it thaws: neutral reports only, so the press that leaves the dock does not reach the game."""

import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _pads import log, unit_name


def main():
    unit = unit_name(os.environ["SESSION_ID"])
    signal = "SIGUSR1" if os.path.basename(sys.argv[0]) == "freeze" else "SIGUSR2"
    r = subprocess.run(["systemctl", "--user", "kill", "--kill-whom=main", f"--signal={signal}", unit], capture_output=True, text=True, check=False)
    if r.returncode != 0 and "not loaded" not in r.stderr.lower():
        log(f"systemctl kill {unit}: {r.stderr.strip()}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
