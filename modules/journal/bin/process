#!/usr/bin/env python3
"""post-process hook: writes the session's journal entry and hands it to `universe journal-add`."""
import json
import os
import shutil
import sys
import tempfile
import traceback
from datetime import datetime, timedelta

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import images as img  # noqa: E402
import prompt as pr  # noqa: E402
import providers  # noqa: E402
from _common import (add_entry_via_core, fmt_date, fmt_time, journal_lang, load_settings, log,  # noqa: E402
                     parse_rfc3339, parse_session_id, read_entries, read_sessions, rfc3339_local, sanitize_game_name,
                     use_system_locale, validate_entry, write_entry_file)
from note import write_note  # noqa: E402

EX_TEMPFAIL = 75
LIMIT_FILE = "codex-limit.json"


class Failed(Exception):
    def __init__(self, reason, code=1):
        super().__init__(reason)
        self.reason = reason
        self.code = code


def env(name, default=""):
    return os.environ.get(name) or default


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def remove(path):
    try:
        os.remove(path)
    except OSError:
        pass


def now_rfc3339():
    return rfc3339_local(datetime.now().astimezone())


def state_path(journal_dir, sid, state):
    return os.path.join(journal_dir, f"{sid}.{state}.json")


def mark_pending(journal_dir, sid, game_id, provider):
    write_json(state_path(journal_dir, sid, "pending"), {"session": sid, "game": game_id, "started_at": now_rfc3339(), "provider": provider})
    remove(state_path(journal_dir, sid, "failed"))


def mark_failed(journal_dir, sid, game_id, reason):
    write_json(state_path(journal_dir, sid, "failed"), {"session": sid, "game": game_id, "written_at": now_rfc3339(), "reason": reason})
    remove(state_path(journal_dir, sid, "pending"))


def memory_path(data_dir, game_id):
    return os.path.join(data_dir, "memory", f"{game_id}.json")


def read_memory(data_dir, game_id, legacy_dir):
    mem = read_json(memory_path(data_dir, game_id))
    if mem is None and legacy_dir:
        mem = read_json(os.path.join(legacy_dir, ".game-memory.json"))
        if mem:
            log("seeded the game memory from the legacy .game-memory.json")
    return mem if isinstance(mem, dict) else None


def active_limit(data_dir):
    saved = read_json(os.path.join(data_dir, LIMIT_FILE))
    until = parse_rfc3339((saved or {}).get("until"))
    if until and until > datetime.now():
        return until
    remove(os.path.join(data_dir, LIMIT_FILE))
    return None


def record_limit(data_dir, until):
    write_json(os.path.join(data_dir, LIMIT_FILE), {"until": rfc3339_local(until)})


def previous_entry_text(entries, sid):
    for e in entries:
        if e["session"] >= sid:
            continue
        text = "\n".join(e.get("paragraphs") or [])
        if e.get("next_up"):
            text += f"\n{e['next_up']}"
        return text.strip()[:1500]
    return ""


def play_stats(sessions, entries, sid, duration_s):
    """Counts only sessions before this one, so a backfill is not told the player is further along."""
    earlier = [s for s in sessions.values() if s.get("session") and s["session"] < sid]
    if earlier or sid in sessions:
        total = sum(int(s.get("duration_s") or 0) for s in earlier) + duration_s
        return len(earlier) + 1, total
    game = read_json_env("UNIVERSE_GAME_JSON")
    stats = (game or {}).get("stats") or {}
    if stats.get("play_count"):
        return max(1, int(stats["play_count"])), int(float(stats.get("hours") or 0) * 3600) or duration_s
    older = sum(1 for e in entries if e["session"] < sid)
    return older + 1, duration_s


def read_json_env(name):
    raw = env(name)
    if not raw:
        return None
    try:
        return json.loads(raw)
    except ValueError:
        return None


def deliver(entry, journal_dir):
    sid = entry["session"]
    payload = json.dumps(entry, ensure_ascii=False)
    outcome = add_entry_via_core(sid, payload)
    if outcome == "ok":
        log("entry handed to the core via universe journal-add")
        return
    if outcome == "invalid":
        raise Failed("the core rejected the entry")
    path = write_entry_file(journal_dir, entry)
    log(f"warning: core unavailable, wrote {path} directly")


def clear_session_frames(attachments, sid):
    try:
        for name in os.listdir(attachments):
            if name.startswith(f"{sid}-") and name.lower().endswith(".png") and not img.SHOT_RE.search(name):
                os.remove(os.path.join(attachments, name))
    except OSError:
        pass


def persist_frames(frames, attachments, sid):
    os.makedirs(attachments, exist_ok=True)
    rels = []
    for i, f in enumerate(frames, 1):
        name = f"{sid}-{i}.png"
        shutil.copyfile(f.file, os.path.join(attachments, name))
        rels.append(f"attachments/{name}")
    return rels


def make_entry(sid, game_id, start, end, duration_s, lang, title, provider, paragraphs, next_up, image_rels):
    return {
        "session": sid,
        "game": game_id,
        "started_at": rfc3339_local(start),
        "ended_at": rfc3339_local(end),
        "duration_s": duration_s,
        "written_at": now_rfc3339(),
        "lang": journal_lang(lang),
        "title": title or "",
        "provider": provider,
        "paragraphs": list(paragraphs),
        "next_up": next_up or "",
        "images": list(image_rels),
    }


def main(argv):
    use_system_locale()
    force = "--force" in argv
    settings = load_settings()
    if not settings.get("enabled", True):
        log("journal disabled for this game")
        return 0

    sid = env("SESSION_ID")
    start_id = parse_session_id(sid)
    if not start_id:
        log(f"SESSION_ID {sid!r} is not YYYYMMDD-HHMMSS")
        return 1
    game_id = env("GAME_ID") or env("GAME_SLUG") or sanitize_game_name(env("GAME_TITLE"))
    journal_dir = env("JOURNAL_DIR")
    data_dir = env("MODULE_DATA_DIR")
    if not journal_dir or not data_dir:
        log("JOURNAL_DIR and MODULE_DATA_DIR are required")
        return 1
    os.makedirs(journal_dir, exist_ok=True)
    os.makedirs(data_dir, exist_ok=True)

    if os.path.exists(os.path.join(journal_dir, f"{sid}.json")) and not force:
        log(f"entry for {sid} already exists, nothing to do (--force to regenerate)")
        return 0

    provider = str(settings.get("provider") or "codex")
    mark_pending(journal_dir, sid, game_id, provider)
    reason = "crashed"
    try:
        journal_session(settings, sid, start_id, game_id, provider, journal_dir, data_dir)
        reason = None
    except Failed as e:
        log(f"no entry for {sid}: {e.reason}")
        reason = e.reason
        return e.code
    except Exception as e:
        reason = f"error: {e}"
        raise
    finally:
        pending = state_path(journal_dir, sid, "pending")
        if reason is None:
            remove(pending)
        elif os.path.exists(pending):
            mark_failed(journal_dir, sid, game_id, reason)
    return 0


def journal_session(settings, sid, start_id, game_id, provider, journal_dir, data_dir):
    title = env("GAME_TITLE") or game_id
    forced_lang = None if str(settings.get("language") or "auto") == "auto" else journal_lang(settings["language"])
    max_images = int(settings["max_images"])
    recording = env("RECORDING_PATH")
    legacy_dir = os.path.join(settings["journal_root"], game_id)

    start = parse_rfc3339(env("SESSION_STARTED_AT")) or start_id
    try:
        duration_s = int(float(env("SESSION_DURATION_S")))
    except ValueError:
        duration_s = 0
    end = parse_rfc3339(env("SESSION_ENDED_AT")) or (start + timedelta(seconds=duration_s))
    if not duration_s:
        duration_s = max(0, int((end - start).total_seconds()))

    attachments = os.path.join(journal_dir, "attachments")
    log(f"journaling {title!r} ({game_id}) session {sid}, provider {provider}")
    shots = img.select_screenshots(attachments, start, end)
    if not recording and not shots:
        log("no recording and no screenshot for this session; nothing to journal")
        return
    log(f"{len(shots)} screenshot(s) in the session window")

    if provider == "codex":
        until = active_limit(data_dir)
        if until:
            log(f"codex usage limit in effect until {fmt_date(until)} {fmt_time(until)}; deferring, no work done")
            raise Failed("codex quota reached", EX_TEMPFAIL)

    sessions = read_sessions(journal_dir)
    sessions.setdefault(sid, {"session": sid, "game": game_id, "started_at": rfc3339_local(start), "ended_at": rfc3339_local(end),
                              "duration_s": duration_s, "source": "hook-env", "recording": recording or None})
    entries = read_entries(journal_dir)
    memory = read_memory(data_dir, game_id, legacy_dir)
    known_lang = forced_lang or (memory or {}).get("language") or (entries[0].get("lang") if entries else None)

    work_root = os.path.join(data_dir, "work")
    os.makedirs(work_root, exist_ok=True)
    work_dir = tempfile.mkdtemp(prefix=f"{sid}-", dir=work_root)
    try:
        need = max(0, min(img.FRAME_FILL_TARGET, max_images) - len(shots))
        frames = []
        if recording and need > 0:
            footage = img.probe_duration(recording) or duration_s
            frames = img.extract_frames(recording, shots, start, need, os.path.join(work_dir, "frames"), footage)
        clear_session_frames(attachments, sid)

        if len(shots) > max_images:
            log(f"{len(shots)} screenshots exceed the {max_images}-image ceiling; feeding an even sample")
        fed = sorted(img.even_sample(shots, max_images) + frames, key=lambda im: im.t)

        if not fed:
            log("the recording holds no picture and no screenshot covers the session")
            raise Failed("no images")

        prev = previous_entry_text(entries, sid)
        number, total = play_stats(sessions, entries, sid, duration_s)

        def brief(intro, lines):
            return pr.build_user_prompt(title, start, end, duration_s, number, total, fed, prev, memory, intro, lines)

        log(f"asking {provider} for the entry ({len(shots)} screenshot(s) + {len(frames)} frame(s))…")
        try:
            raw = providers.generate(provider, model=str(settings.get("model") or ""), title=title, brief_builder=brief,
                                     images=fed, work_dir=work_dir, forced_lang=forced_lang)
        except providers.QuotaExceeded as e:
            record_limit(data_dir, e.until)
            log(f"codex usage limit reached; journal paused until {fmt_date(e.until)} {fmt_time(e.until)}")
            raise Failed("codex quota reached", EX_TEMPFAIL)
        except Exception as e:
            traceback.print_exc()
            raise Failed(f"provider error: {e}")
        result = pr.accept_result(raw)
        if not result:
            raise Failed("the model produced no usable entry")

        merged = pr.merge_memory(memory, result["memory"], warn=log)
        lang = forced_lang or journal_lang((merged or {}).get("language") or known_lang)
        order, unusable = img.normalize_review(result["images"], len(fed))
        kept_shots, picked = img.pick_gallery(fed, order, unusable, shots, frames)
        rels = [os.path.relpath(s.file, journal_dir) for s in kept_shots] + persist_frames(picked, attachments, sid)
        paragraphs = pr.paragraphs_from_body(result["body"])
        entry = make_entry(sid, game_id, start, end, duration_s, lang, result["title"], provider, paragraphs, result["next"], rels)
    finally:
        shutil.rmtree(work_dir, ignore_errors=True)
    finish(entry, journal_dir, settings, title, game_id, sessions, merged, data_dir)


def finish(entry, journal_dir, settings, title, game_id, sessions, memory, data_dir):
    errors = validate_entry(entry)
    if errors:
        raise Failed(f"internal error, entry invalid: {errors}")
    deliver(entry, journal_dir)
    remove(state_path(journal_dir, entry["session"], "pending"))
    log(f"journal entry written{': ' + repr(entry['title']) if entry['title'] else ''}")
    if memory:
        write_json(memory_path(data_dir, game_id), memory)
    if settings.get("markdown_export", True):
        entries = [e for e in read_entries(journal_dir) if e["session"] != entry["session"]] + [entry]
        try:
            path, changed = write_note(entries, sessions, title, journal_dir, os.path.join(settings["journal_root"], game_id))
            log(f"markdown note {'updated' if changed else 'unchanged'}: {path}")
        except OSError as e:
            log(f"markdown render failed: {e}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
