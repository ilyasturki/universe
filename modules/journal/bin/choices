#!/usr/bin/env python3
"""choices_exec for `model`: the current provider's models as a JSON array on stdout."""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import load_settings, log  # noqa: E402

# `claude` has no catalog; these are the aliases its --model documents.
CLAUDE_MODELS = ["fable", "opus", "sonnet", "haiku"]


def codex_models():
    try:
        out = subprocess.run(["codex", "debug", "models"], capture_output=True, text=True, check=True, timeout=15).stdout
        models = json.loads(out).get("models") or []
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError) as e:
        log(f"codex debug models failed: {e}")
        return []
    listed = [m for m in models if isinstance(m, dict) and m.get("slug") and m.get("visibility", "list") == "list"]
    listed.sort(key=lambda m: (m.get("priority") if isinstance(m.get("priority"), int) else 1 << 30))
    return [m["slug"] for m in listed]


def main(argv):
    if argv[:1] != ["model"]:
        log(f"usage: choices model (got {argv})")
        return 2
    provider = load_settings().get("provider")
    if provider == "codex":
        models = codex_models()
    elif provider == "claude":
        models = CLAUDE_MODELS
    else:
        models = []
    print(json.dumps(models))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
