#!/usr/bin/env python3
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import providers
from _common import load_settings, log, read_text, setting_bool, setting_int, setting_str


def options(settings):
    key = setting_str(settings, "api_key")
    key_file = setting_str(settings, "api_key_file")
    if key_file:
        key = (read_text(key_file) or "").strip() or key
    return providers.Options(
        provider=setting_str(settings, "provider"),
        model=setting_str(settings, "model"),
        base_url=setting_str(settings, "base_url"),
        api_key=key,
        effort=setting_str(settings, "effort", "high"),
        web_search=setting_bool(settings, "web_search", True),
        attempts=max(1, setting_int(settings, "attempts", providers.ATTEMPTS)),
    )


def main(argv):
    if argv[:1] != ["model"]:
        log(f"usage: choices model (got {argv})")
        return 2
    print(json.dumps(providers.models(options(load_settings()))))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
